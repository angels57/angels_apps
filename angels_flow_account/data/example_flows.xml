<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Example: every Monday, follow up the overdue customer invoices. -->
    <record id="example_flow_overdue_invoices" model="angels.flow" context="{'angels_flow_no_start': True}">
        <field name="name">Overdue Invoices Follow-Up</field>
        <field name="is_example" eval="True"/>
        <field name="enabled" eval="False"/>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="trigger">scheduled</field>
        <field name="interval_number">1</field>
        <field name="interval_type">weeks</field>
        <field name="once_per_record" eval="False"/>
        <field name="filter_domain">[("move_type", "=", "out_invoice"), ("state", "=", "posted"), ("payment_state", "in", ["not_paid", "partial"]), ("invoice_date_due", "&lt;", context_today().strftime("%Y-%m-%d"))]</field>
        <field name="description">Every week, the accounting managers are told about each overdue customer invoice. Three days later, if it is still unpaid, its salesperson gets a task to call the customer.</field>
    </record>

    <record id="example_invoice_paid" model="angels.flow.node">
        <field name="flow_id" ref="example_flow_overdue_invoices"/>
        <field name="name">Paid in the Meantime</field>
        <field name="node_type">end</field>
        <field name="pos_x">880</field>
        <field name="pos_y">280</field>
    </record>
    <record id="example_invoice_end" model="angels.flow.node">
        <field name="flow_id" ref="example_flow_overdue_invoices"/>
        <field name="name">Followed Up</field>
        <field name="node_type">end</field>
        <field name="pos_x">1440</field>
        <field name="pos_y">40</field>
    </record>
    <record id="example_invoice_call" model="angels.flow.node">
        <field name="flow_id" ref="example_flow_overdue_invoices"/>
        <field name="name">Call the Customer</field>
        <field name="node_type">task</field>
        <field name="color">6</field>
        <field name="assign_type">field</field>
        <field name="user_field_id" ref="account.field_account_move__invoice_user_id"/>
        <field name="deadline_amount">2</field>
        <field name="deadline_unit">days</field>
        <field name="on_deadline">remind</field>
        <field name="pos_x">1160</field>
        <field name="pos_y">40</field>
        <field name="next_id" ref="example_invoice_end"/>
    </record>
    <record id="example_invoice_unpaid" model="angels.flow.node">
        <field name="flow_id" ref="example_flow_overdue_invoices"/>
        <field name="name">Still Unpaid?</field>
        <field name="node_type">condition</field>
        <field name="pos_x">880</field>
        <field name="pos_y">120</field>
        <field name="yes_id" ref="example_invoice_call"/>
        <field name="no_id" ref="example_invoice_paid"/>
    </record>
    <record id="example_invoice_unpaid_condition" model="angels.flow.condition">
        <field name="node_id" ref="example_invoice_unpaid"/>
        <field name="field_id" ref="account.field_account_move__payment_state"/>
        <field name="operator">=</field>
        <field name="value">not_paid</field>
    </record>
    <record id="example_invoice_wait" model="angels.flow.node">
        <field name="flow_id" ref="example_flow_overdue_invoices"/>
        <field name="name">Three Days Later</field>
        <field name="node_type">wait</field>
        <field name="wait_amount">3</field>
        <field name="wait_unit">days</field>
        <field name="pos_x">600</field>
        <field name="pos_y">120</field>
        <field name="next_id" ref="example_invoice_unpaid"/>
    </record>
    <record id="example_invoice_notify" model="angels.flow.node">
        <field name="flow_id" ref="example_flow_overdue_invoices"/>
        <field name="name">Tell Accounting</field>
        <field name="node_type">notify</field>
        <field name="color">9</field>
        <field name="assign_type">group</field>
        <field name="group_id" ref="account.group_account_manager"/>
        <field name="pos_x">320</field>
        <field name="pos_y">120</field>
        <field name="next_id" ref="example_invoice_wait"/>
    </record>
    <record id="example_invoice_start" model="angels.flow.node">
        <field name="flow_id" ref="example_flow_overdue_invoices"/>
        <field name="name">Start</field>
        <field name="node_type">start</field>
        <field name="pos_x">40</field>
        <field name="pos_y">120</field>
        <field name="next_id" ref="example_invoice_notify"/>
    </record>

</odoo>
