#. module: angels_flow_account
#: model:angels.flow.node,name:angels_flow_account.example_invoice_call
msgid "Call the Customer"
msgstr "Llamar al cliente"

#. module: angels_flow_account
#: model:angels.flow.node,name:angels_flow_account.example_invoice_end
msgid "Followed Up"
msgstr "Seguimiento hecho"

#. module: angels_flow_account
#: model:angels.flow,name:angels_flow_account.example_flow_overdue_invoices
msgid "Overdue Invoices Follow-Up"
msgstr "Revisión de facturas vencidas"

#. module: angels_flow_account
#: model:angels.flow.node,name:angels_flow_account.example_invoice_paid
msgid "Paid in the Meantime"
msgstr "Pagada mientras tanto"

#. module: angels_flow_account
#: model:angels.flow.node,name:angels_flow_account.example_invoice_start
msgid "Start"
msgstr "Inicio"

#. module: angels_flow_account
#: model:angels.flow.node,name:angels_flow_account.example_invoice_unpaid
msgid "Still Unpaid?"
msgstr "¿Sigue sin pagar?"

#. module: angels_flow_account
#: model:angels.flow.node,name:angels_flow_account.example_invoice_notify
msgid "Tell Accounting"
msgstr "Avisar a Contabilidad"

#. module: angels_flow_account
#: model:angels.flow.node,name:angels_flow_account.example_invoice_wait
msgid "Three Days Later"
msgstr "Tres días después"

#. module: angels_flow_account
#: model:angels.flow,description:angels_flow_account.example_flow_overdue_invoices
msgid ""
"Every week, the accounting managers are told about each overdue customer "
"invoice. Three days later, if it is still unpaid, its salesperson gets a "
"task to call the customer."
msgstr ""
"Cada semana se avisa a los responsables de contabilidad de cada factura de "
"cliente vencida. Tres días después, si sigue sin pagar, su comercial recibe "
"una tarea para llamar al cliente."
