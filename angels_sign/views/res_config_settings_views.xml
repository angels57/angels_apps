<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.easy.sign</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="priority" eval="90"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Angels Sign" string="Angels Sign" name="angels_sign" groups="angels_sign.group_sign_manager">
                    <block title="Sign Settings" name="angels_sign_settings">
                        <setting id="sign_terms" string="Sign Default Terms &amp; Conditions"
                                 help="Add terms &amp; conditions to the signature request email">
                            <field name="use_sign_terms"/>
                            <div class="content-group" invisible="not use_sign_terms">
                                <div class="mt16">
                                    <field name="sign_terms_type" widget="radio" options="{'horizontal': true}"/>
                                </div>
                                <div class="mt8">
                                    <field name="sign_terms" class="oe-bordered-editor" placeholder="Your conditions..."/>
                                </div>
                                <div class="mt8" invisible="sign_terms_type != 'html'">
                                    <field name="sign_terms_url" widget="url" readonly="1"/>
                                </div>
                            </div>
                        </setting>
                        <setting id="sign_template_access" string="Manage template access"
                                 help="Allow users to define the users or groups which have access to the template">
                            <field name="group_manage_template_access"/>
                        </setting>
                        <setting id="sign_sms" string="Authenticate by SMS"
                                 help="Deliver one-time codes by SMS to identify signatories when signing a document">
                            <div class="text-muted">Choose "Email link + SMS code" as the signer verification.</div>
                            <div class="text-muted">Codes are sent with Odoo SMS, which uses IAP credits.</div>
                        </setting>
                        <setting id="sign_certificate" string="Cryptographic signature"
                                 help="Certify your documents using a provided .pfx or .p12 file.">
                            <div class="content-group">
                                <div class="row">
                                    <label for="signing_certificate_id" string="Signing certificate" class="col-lg-4 o_light_label"/>
                                    <field name="signing_certificate_id" options="{'no_create': True}"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_angels_sign_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'angels_sign', 'bin_size': False}</field>
    </record>
</odoo>
