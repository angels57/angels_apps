<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="angels_sign.EditorAction">
        <div class="o_action o_es_editor_action">
            <EditorTopbar t-if="this.data" store="this.store" breadcrumbs="this.breadcrumbs" onSend="() => this.onSend()"
                          onSignNow="() => this.onSignNow()" onProperties="() => this.onProperties()"/>
            <div t-if="this.data and this.data.locked" class="o_es_locked" role="status">
                <span t-out="this.data.locked"/>
                <button t-if="this.resModel === 'sign.template' and this.data.is_manager" type="button"
                        class="btn btn-sm btn-secondary ms-2" t-on-click="() => this.onEditCopy()">Edit a Copy</button>
            </div>
            <div t-if="!this.data" class="o_es_empty">Open a document from the list to edit it.</div>
            <div t-else="" class="o_es_body">
                <EditorPanel store="this.store"/>
                <EditorViewer store="this.store"/>
            </div>
        </div>
    </t>

    <t t-name="angels_sign.EditorTopbar">
        <div class="o_es_topbar">
            <div class="o_es_actions">
                <button t-if="this.data.can_send" type="button"
                        class="btn btn-primary" t-on-click="() => this.props.onSend()">Send</button>
                <button t-if="this.data.can_sign_now" type="button" class="btn btn-primary" t-on-click="() => this.props.onSignNow()">Sign Now</button>
            </div>
            <div class="o_es_titles">
                <div class="o_es_crumbs">
                    <t t-foreach="this.props.breadcrumbs" t-as="crumb" t-key="crumb_index">
                        <a href="#" t-on-click.prevent="() => crumb.onSelected()" t-out="crumb.name"/>
                        <span class="o_es_sep">/</span>
                    </t>
                </div>
                <div class="o_es_name">
                    <input t-if="this.data.editable_name and !this.data.locked" type="text" class="o_es_name_input"
                           t-att-value="this.data.name" t-on-change="(ev) => this.onRename(ev)"/>
                    <span t-else="" t-out="this.data.name"/>
                    <button type="button" class="o_es_icon_btn" title="Properties" t-on-click="() => this.props.onProperties()"><i class="o_es_i o_es_i_cog"/></button>
                    <i t-if="this.state.saving" class="o_es_i o_es_i_spinner o_es_i_spin o_es_saved" title="Saving…"/>
                    <i t-else="" class="o_es_i o_es_i_cloud o_es_saved" title="Saved"/>
                </div>
            </div>
            <div class="o_es_tags">
                <span class="o_es_tags_label">Tags:</span>
                <span t-foreach="this.data.tags" t-as="tag" t-key="tag.id" t-attf-class="o_es_tag o_tag_color_{{tag.color or 0}}">
                    <t t-out="tag.name"/>
                    <i class="o_es_i o_es_i_close" title="Remove" t-on-click="() => this.removeTag(tag)"/>
                </span>
                <div class="o_es_tag_add">
                    <input type="text" placeholder="Add a tag" t-on-focus="() => this.openTags()" t-on-keydown="(ev) => this.createTag(ev)"
                           t-on-blur="() => this.closeTagsLater()"/>
                    <div t-if="this.tags.open and this.availableTags.length" class="o_es_tag_menu">
                        <button t-foreach="this.availableTags" t-as="tag" t-key="tag.id" type="button"
                                t-on-mousedown.prevent="() => this.addTag(tag)" t-out="tag.name"/>
                    </div>
                </div>
            </div>
        </div>
    </t>

    <t t-name="angels_sign.EditorPanel">
        <aside class="o_es_panel">
            <div class="o_es_section_head">
                <span>Documents</span>
                <a t-if="!this.locked" href="#" class="o_es_add" t-on-click.prevent="() => this.onAddDocument()">Add</a>
            </div>
            <div t-foreach="this.state.documents" t-as="doc" t-key="doc.id" class="o_es_row">
                <span class="o_es_row_name" t-out="doc.name"/>
                <Dropdown t-if="!this.locked" items="this.docMenu(doc)" position="'bottom-end'">
                    <button type="button" class="o_es_kebab" title="Options"><i class="o_es_i o_es_i_kebab"/></button>
                </Dropdown>
            </div>

            <div class="o_es_section_head">
                <span>Signers</span>
                <a t-if="!this.locked" href="#" class="o_es_add" t-on-click.prevent="() => this.onAddParty()">Add</a>
            </div>
            <t t-foreach="this.state.parties" t-as="party" t-key="party.id">
                <div t-attf-class="o_es_row o_es_party o_es_c{{party.color % 12}} {{this.state.party === party.id ? 'active' : ''}}"
                     t-on-click="() => this.selectParty(party)">
                    <span class="o_es_row_name" t-out="party.name"/>
                    <img t-if="party.avatar" class="o_es_avatar" t-att-src="party.avatar" alt=""/>
                    <span class="o_es_count" t-out="this.countOf(party)"/>
                    <Dropdown items="this.partyMenu(party)" position="'bottom-end'">
                        <button type="button" class="o_es_kebab" title="Options" t-on-click.stop="() => {}"><i class="o_es_i o_es_i_kebab"/></button>
                    </Dropdown>
                </div>
                <div t-if="this.state.party === party.id and !this.locked" t-attf-class="o_es_palette o_es_c{{party.color % 12}}">
                    <button t-foreach="this.palette" t-as="entry" t-key="entry.id" type="button" class="o_es_tool"
                            t-on-pointerdown="(ev) => this.onPalettePointerDown(ev, entry)">
                        <i t-attf-class="o_es_i o_es_i_{{entry.icon}}"/> <span t-out="entry.label"/>
                    </button>
                    <button t-if="this.state.data.is_manager" type="button" class="o_es_tool o_es_tool_add" t-on-click="() => this.onAddFieldType()">
                        <i class="o_es_i o_es_i_plus"/> <span>Add Field</span>
                    </button>
                </div>
            </t>
            <div t-if="!this.state.parties.length" class="o_es_hint">Add a signer to place fields.</div>
        </aside>
    </t>

    <t t-name="angels_sign.EditorViewer">
        <div class="o_es_viewer">
            <div class="o_es_toolbar">
                <div class="o_es_toolbar_group">
                    <button type="button" class="o_es_tbtn" title="Previous page" t-on-click="() => this.goToPage(this.view.pageIndex - 1)"><i class="o_es_i o_es_i_chevron_up"/></button>
                    <input type="number" min="1" class="o_es_page_input" t-att-value="this.view.pageIndex + 1" t-on-change="(ev) => this.onPageInput(ev)"/>
                    <span class="o_es_of">of <t t-out="this.allPages.length"/></span>
                    <button type="button" class="o_es_tbtn" title="Next page" t-on-click="() => this.goToPage(this.view.pageIndex + 1)"><i class="o_es_i o_es_i_chevron_down"/></button>
                </div>
                <div class="o_es_toolbar_group">
                    <button type="button" class="o_es_tbtn" title="Zoom out" t-on-click="() => this.zoomStep(-1)"><i class="o_es_i o_es_i_minus"/></button>
                    <select class="o_es_zoom" t-on-change="(ev) => this.setZoom(ev.target.value === 'auto' ? 'auto' : Number(ev.target.value))">
                        <option value="auto" t-att-selected="this.view.zoom === 'auto'">Automatic Zoom</option>
                        <option t-foreach="this.zooms" t-as="z" t-key="z" t-att-value="z" t-att-selected="this.view.zoom === z"><t t-out="this.zoomLabel(z)"/></option>
                    </select>
                    <button type="button" class="o_es_tbtn" title="Zoom in" t-on-click="() => this.zoomStep(1)"><i class="o_es_i o_es_i_plus"/></button>
                </div>
                <div class="o_es_toolbar_group">
                    <i class="o_es_i o_es_i_search o_es_search_icon"/>
                    <input type="search" class="o_es_search" placeholder="Search" t-on-keydown="(ev) => this.onSearch(ev)"/>
                    <span t-if="this.view.query" class="o_es_of">
                        <t t-if="this.view.results.length"><t t-out="this.view.resultIndex + 1"/>/<t t-out="this.view.results.length"/></t>
                        <t t-else="">0</t>
                    </span>
                </div>
                <button type="button" t-attf-class="o_es_tbtn o_es_thumbs_btn {{this.view.thumbs ? 'active' : ''}}" title="Thumbnails" t-on-click="() => this.toggleThumbs()"><i class="o_es_i o_es_i_thumbnails"/></button>
            </div>
            <div class="o_es_viewer_body">
                <div class="o_es_pages" t-on-scroll="() => this.onScroll()">
                    <t t-foreach="this.state.documents" t-as="doc" t-key="doc.id">
                        <div t-foreach="this.pagesOf(doc)" t-as="page" t-key="page"
                             t-attf-class="o_es_page {{this.view.flash === doc.id + '-' + page ? 'o_es_flash' : ''}}"
                             t-att-style="this.pageStyle(doc, page)"
                             t-att-data-doc="doc.id" t-att-data-page="page" t-on-click="() => this.onPageClick()">
                            <canvas/>
                            <div t-foreach="this.guidesOf(doc, page)" t-as="guide" t-key="guide_index"
                                 t-attf-class="o_es_guide o_es_guide_{{guide.axis}}" t-att-style="this.guideStyle(guide)"/>
                            <t t-foreach="this.itemsOf(doc.id, page)" t-as="item" t-key="item.id">
                                <div t-attf-class="o_es_item o_es_item_{{item.type}} o_es_c{{this.partyOf(item).color % 12}} {{this.state.selectedId === item.id ? 'selected' : ''}} {{item.required ? '' : 'optional'}}"
                                     t-att-style="this.itemStyle(item)"
                                     t-on-pointerdown="(ev) => this.startDrag(ev, item, 'move')"
                                     t-on-click.stop="() => {}">
                                    <span t-if="['signature', 'initials'].includes(item.type)" class="o_es_item_script" t-out="this.partyOf(item).name"/>
                                    <span t-else="" class="o_es_item_label" t-out="this.itemLabel(item)"/>
                                    <span t-if="!this.store.locked" class="o_es_resize"
                                          t-on-pointerdown.stop="(ev) => this.startDrag(ev, item, 'resize')"/>
                                </div>
                                <div t-if="this.state.selectedId === item.id and !this.store.locked" class="o_es_popover_anchor"
                                     t-attf-style="left:{{item.pos_x * 100}}%;top:{{(item.pos_y + item.height) * 100}}%;"
                                     t-on-click.stop="() => {}" t-on-pointerdown.stop="() => {}">
                                    <FieldPopover store="this.store" item="item" onAllPages="() => this.copyToAllPages(item)"/>
                                </div>
                            </t>
                        </div>
                    </t>
                </div>
                <aside t-if="this.view.thumbs" class="o_es_thumbs">
                    <t t-foreach="this.allPages" t-as="entry" t-key="entry_index">
                        <button type="button" t-attf-class="o_es_thumb {{this.view.pageIndex === entry_index ? 'active' : ''}}"
                                t-on-click="() => this.goToPage(entry_index)">
                            <canvas t-att-data-doc="entry.doc.id" t-att-data-page="entry.page"/>
                            <span t-out="entry_index + 1"/>
                        </button>
                    </t>
                </aside>
            </div>
        </div>
    </t>

    <t t-name="angels_sign.FieldPopover">
        <div class="o_es_popover">
            <div class="o_es_popover_title" t-out="this.itemLabel(this.item)"/>
            <select class="o_input" t-on-change="(ev) => this.onParty(ev)">
                <option t-foreach="this.state.parties" t-as="party" t-key="party.id" t-att-value="party.id"
                        t-att-selected="this.item[this.store.partyField] === party.id" t-out="party.name"/>
            </select>
            <label class="o_es_check">
                <input type="checkbox" t-att-checked="this.item.required"
                       t-on-change="(ev) => this.update({ required: ev.target.checked })"/> Required
            </label>
            <label class="o_es_check" t-if="this.isTextual">
                <input type="checkbox" t-att-checked="this.item.readonly"
                       t-on-change="(ev) => this.update({ readonly: ev.target.checked })"/> Read-only
            </label>
            <input t-if="this.isTextual" type="text" class="o_input" placeholder="Placeholder"
                   t-att-value="this.item.placeholder or ''" t-on-change="(ev) => this.update({ placeholder: ev.target.value })"/>
            <textarea t-if="this.hasOptions" class="o_input" rows="3" placeholder="One option per line"
                      t-on-change="(ev) => this.update({ options: ev.target.value })" t-out="this.item.options or ''"/>
            <select t-if="this.isTextual" class="o_input" t-on-change="(ev) => this.update({ alignment: ev.target.value })">
                <option value="left" t-att-selected="this.item.alignment === 'left'">Left</option>
                <option value="center" t-att-selected="this.item.alignment === 'center'">Center</option>
                <option value="right" t-att-selected="this.item.alignment === 'right'">Right</option>
            </select>
            <select t-if="['text', 'textarea'].includes(this.item.type)" class="o_input"
                    t-on-change="(ev) => this.update({ linked_field: ev.target.value or false })">
                <option value="">No auto-complete</option>
                <option t-foreach="this.linked" t-as="entry" t-key="entry[0]" t-att-value="entry[0]"
                        t-att-selected="this.item.linked_field === entry[0]" t-out="entry[1]"/>
            </select>
            <div class="o_es_popover_actions">
                <button type="button" class="btn btn-secondary btn-sm" t-on-click="() => this.props.onAllPages()">All pages</button>
                <button type="button" class="btn btn-danger btn-sm" t-on-click="() => this.store.deleteItem(this.item)">Delete</button>
            </div>
        </div>
    </t>

</templates>
