<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="mail_layout">
        <div style="font-family:'Segoe UI',Arial,sans-serif;max-width:600px;margin:0 auto;background:#ffffff;border:1px solid #e2e8f0;border-radius:12px;overflow:hidden;">
            <div style="background:#1a1a2e;padding:24px 28px;color:#ffffff;">
                <div style="font-size:12px;opacity:.7;" t-out="company.name"/>
                <div style="font-size:20px;font-weight:700;margin-top:4px;" t-out="title"/>
            </div>
            <div style="padding:28px;color:#1e293b;font-size:14px;line-height:1.6;">
                <t t-out="0"/>
            </div>
            <div style="background:#f8fafc;padding:14px 28px;font-size:11px;color:#94a3b8;border-top:1px solid #e2e8f0;">
                Angels Sign · <t t-out="sign_request.name"/>
            </div>
        </div>
    </template>

    <template id="mail_button">
        <p style="text-align:center;margin:28px 0;">
            <a t-att-href="url" style="display:inline-block;background:#2563eb;color:#ffffff;text-decoration:none;padding:14px 36px;border-radius:8px;font-weight:700;" t-out="label"/>
        </p>
    </template>

    <template id="mail_invitation">
        <t t-call="angels_sign.mail_layout" title="reminder and 'Reminder: signature pending' or 'Document Signature Request'">
            <p>Hello <strong t-out="signer.signer_name"/>,</p>
            <p><strong t-out="sign_request.user_id.name"/> asks you to sign
                <strong t-out="sign_request.document_name or sign_request.name"/>.</p>
            <div t-if="sign_request.message" style="background:#fffbeb;border:1px solid #fde68a;border-radius:8px;padding:12px 16px;margin:16px 0;" t-out="sign_request.message"/>
            <p t-if="sign_request.expiry_date" style="color:#dc2626;">Valid until <t t-out="sign_request.expiry_date"/>.</p>
            <t t-call="angels_sign.mail_button" url="sign_url" label.translate="Review &amp; Sign"/>
            <p style="font-size:12px;color:#64748b;word-break:break-all;">Link: <a t-att-href="sign_url" t-out="sign_url"/></p>
            <p style="font-size:12px;color:#64748b;">This link is personal. Do not share it.</p>
            <div t-if="terms.get('html')" style="border-top:1px solid #e2e8f0;margin-top:16px;padding-top:12px;font-size:12px;color:#475569;">
                <p style="font-weight:600;margin:0 0 6px;">Terms &amp; Conditions</p>
                <div t-out="terms['html']"/>
            </div>
            <p t-if="terms.get('url')" style="font-size:12px;color:#64748b;">
                By signing you accept our <a t-att-href="terms['url']">Terms &amp; Conditions</a>.
            </p>
        </t>
    </template>

    <template id="mail_otp">
        <t t-call="angels_sign.mail_layout" title.translate="Your signing code">
            <p>Hello <strong t-out="signer.signer_name"/>,</p>
            <p>Use this code to sign <strong t-out="sign_request.document_name or sign_request.name"/>:</p>
            <p style="font-size:32px;font-weight:700;letter-spacing:8px;text-align:center;" t-out="code"/>
            <p style="font-size:12px;color:#64748b;">The code is valid for 10 minutes. If you did not ask for it, ignore this email.</p>
        </t>
    </template>

    <template id="mail_completed">
        <t t-call="angels_sign.mail_layout" title.translate="Document fully signed">
            <p>All parties have signed <strong t-out="sign_request.document_name or sign_request.name"/>.</p>
            <p>The signed document and its certificate of completion are attached.</p>
            <p style="font-size:12px;color:#64748b;">Verification code: <strong t-out="sign_request.verification_code"/></p>
        </t>
    </template>

    <template id="mail_declined">
        <t t-call="angels_sign.mail_layout" title.translate="Signature declined">
            <p><strong t-out="signer.signer_name"/> (<t t-out="signer.signer_email"/>) declined to sign
                <strong t-out="sign_request.document_name or sign_request.name"/>. The request has been cancelled.</p>
            <p t-if="signer.declined_reason"><strong>Reason:</strong> <t t-out="signer.declined_reason"/></p>
        </t>
    </template>

    <template id="mail_cancelled">
        <t t-call="angels_sign.mail_layout" title.translate="Signature request cancelled">
            <p>Hello <strong t-out="signer.signer_name"/>,</p>
            <p>The request to sign <strong t-out="sign_request.document_name or sign_request.name"/> has been cancelled. No action is needed.</p>
        </t>
    </template>

</odoo>
