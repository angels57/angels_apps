<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cron_expire_requests" model="ir.cron">
        <field name="name">Easy Sign: expire requests</field>
        <field name="model_id" ref="model_sign_request"/>
        <field name="state">code</field>
        <field name="code">model._cron_expire_requests()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
    <record id="cron_send_reminders" model="ir.cron">
        <field name="name">Easy Sign: send reminders</field>
        <field name="model_id" ref="model_sign_request"/>
        <field name="state">code</field>
        <field name="code">model._cron_send_reminders()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
</odoo>
