<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_angels_flow" model="ir.module.category">
        <field name="name">Angels Flow</field>
        <field name="sequence">63</field>
    </record>

    <record id="res_groups_privilege_angels_flow" model="res.groups.privilege">
        <field name="name">Angels Flow</field>
        <field name="category_id" ref="module_category_angels_flow"/>
        <field name="sequence">63</field>
    </record>

    <record id="group_flow_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="res_groups_privilege_angels_flow"/>
        <field name="sequence">10</field>
    </record>

    <record id="group_flow_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="privilege_id" ref="res_groups_privilege_angels_flow"/>
        <field name="sequence">20</field>
        <field name="implied_ids" eval="[(4, ref('angels_flow.group_flow_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- Every internal user can act on the flows that reach them. -->
    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('angels_flow.group_flow_user'))]"/>
    </record>

</odoo>
