<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Each condition reads as a sentence: "Show if [question] [is] [value]", each part a pill. -->
    <t t-name="angels_flow.ConditionEditor">
        <div class="o_af_conditions">
            <p t-if="!this.item.conditions.length" class="text-muted small mb-2" t-out="this.props.emptyText"/>
            <div t-if="this.item.conditions.length > 1" class="o_af_segment mb-2" role="radiogroup" aria-label="Match">
                <button type="button" role="radio" t-att-aria-checked="this.match === 'all'"
                        t-attf-class="o_af_segment_item #{this.match === 'all' ? 'active' : ''}"
                        t-on-click="() => this.setMatch('all')">All of them</button>
                <button type="button" role="radio" t-att-aria-checked="this.match === 'any'"
                        t-attf-class="o_af_segment_item #{this.match === 'any' ? 'active' : ''}"
                        t-on-click="() => this.setMatch('any')">Any of them</button>
            </div>
            <t t-foreach="this.item.conditions" t-as="condition" t-key="condition_index">
                <div t-if="condition_index" class="o_af_condition_glue" t-out="this.glue"/>
                <div class="o_af_condition">
                    <t t-set="source" t-value="this.source(condition)"/>
                    <span t-if="!condition_index and this.props.lead" class="o_af_condition_lead" t-out="this.props.lead"/>
                    <select class="o_af_pill o_af_pill_strong" aria-label="Question"
                            t-on-change="(ev) => this.setSource(condition, ev)">
                        <option t-if="!source" value="" selected="">Missing question</option>
                        <t t-foreach="this.sources" t-as="option" t-key="option.id">
                            <option t-att-value="option.id" t-att-selected="option.id === condition.source_id"
                                    t-out="option.name"/>
                        </t>
                    </select>
                    <t t-if="source">
                        <select class="o_af_pill" aria-label="Operator" t-on-change="(ev) => this.setOperator(condition, ev)">
                            <t t-foreach="this.operators(condition)" t-as="operator" t-key="operator">
                                <option t-att-value="operator" t-att-selected="operator === condition.operator"
                                        t-out="this.props.labels[operator]"/>
                            </t>
                        </select>
                        <t t-if="this.needsValue(condition)">
                            <select t-if="source.type === 'boolean'" class="o_af_pill o_af_pill_value" aria-label="Value"
                                    t-on-change="(ev) => this.setValue(condition, ev.target.value)">
                                <option value="1" t-att-selected="condition.value === '1'">Checked</option>
                                <option value="0" t-att-selected="condition.value !== '1'">Not checked</option>
                            </select>
                            <select t-elif="source.type === 'selection' or source.type === 'multi'"
                                    class="o_af_pill o_af_pill_value" aria-label="Value"
                                    t-on-change="(ev) => this.setValue(condition, ev.target.value)">
                                <t t-foreach="source.options" t-as="option" t-key="option_index">
                                    <option t-att-value="option" t-att-selected="option === condition.value" t-out="option"/>
                                </t>
                            </select>
                            <div t-elif="source.type === 'user' or source.type === 'partner'" class="o_af_pill o_af_pill_record">
                                <RecordSelector resModel="source.type === 'user' ? 'res.users' : 'res.partner'"
                                                resId="this.recordValue(condition)"
                                                update="(id) => this.setValue(condition, id)"/>
                            </div>
                            <input t-else="" class="o_af_pill o_af_pill_value o_af_pill_input" aria-label="Value"
                                   placeholder="value"
                                   t-att-type="source.type === 'number' ? 'number' : source.type === 'date' ? 'date' : 'text'"
                                   t-att-value="condition.value"
                                   t-on-change="(ev) => this.setValue(condition, ev.target.value)"/>
                        </t>
                    </t>
                    <button type="button" class="o_af_condition_remove" title="Remove condition"
                            aria-label="Remove condition" t-on-click="() => this.remove(condition_index)">
                        <i class="fa fa-times" aria-hidden="true"/>
                    </button>
                </div>
            </t>
            <button type="button" class="o_af_add_condition" t-att-disabled="!this.sources.length"
                    t-on-click="() => this.add()">
                <i class="fa fa-plus me-1" aria-hidden="true"/>Add Condition
            </button>
            <p t-if="!this.sources.length" class="text-muted small mt-1 mb-0">
                No question can be used here yet.
            </p>
            <p t-if="this.props.summary" class="o_af_condition_summary">
                <i class="fa fa-eye me-1" aria-hidden="true"/><t t-out="this.props.summary"/>
            </p>
        </div>
    </t>

</templates>
