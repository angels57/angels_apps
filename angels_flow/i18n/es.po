#. module: angels_flow
#: model:angels.flow,description:angels_flow.example_flow_welcome
msgid ""
"When a company is created, its salesperson calls it within a day. Three days"
" later, a note is written on the contact."
msgstr ""
"Cuando se crea una empresa, su comercial la llama en menos de un día. Tres "
"días después, se escribe una nota en el contacto."

#. module: angels_flow
#: model_terms:ir.ui.view,arch_db:angels_flow.view_flow_form
msgid ""
"<span invisible=\"not enabled\" class=\"text-success\">On: it starts as set below.</span>\n"
"                        <span invisible=\"enabled\" class=\"text-muted\">Off: it does not start. Switch it on when it is ready.</span>"
msgstr ""
"<span invisible=\"not enabled\" class=\"text-success\">Activado: empieza como se indica abajo.</span>\n"
"                        <span invisible=\"enabled\" class=\"text-muted\">Desactivado: no empieza. Actívalo cuando esté listo.</span>"

#. module: angels_flow
#: model:ir.model.fields,help:angels_flow.field_angels_flow__active
