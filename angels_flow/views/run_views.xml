<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_run_list" model="ir.ui.view">
        <field name="name">angels.flow.run.list</field>
        <field name="model">angels.flow.run</field>
        <field name="arch" type="xml">
            <list create="0" decoration-muted="state == 'cancelled'" decoration-bf="is_my_turn">
                <field name="name"/>
                <field name="flow_id"/>
                <field name="record_name"/>
                <field name="current_step_id" string="Current Step"/>
                <field name="wait_until" optional="show"/>
                <field name="date_start" optional="show"/>
                <field name="date_done" optional="hide"/>
                <field name="activity_ids" widget="list_activity" optional="show"/>
                <field name="is_my_turn" column_invisible="1"/>
                <field name="state" widget="badge" decoration-info="state == 'pending'"
                       decoration-success="state == 'approved'" decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <record id="view_run_form" model="ir.ui.view">
        <field name="name">angels.flow.run.form</field>
        <field name="model">angels.flow.run</field>
        <field name="arch" type="xml">
            <form string="Run" create="0" edit="0">
                <header>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary"
                            invisible="not is_my_turn or current_step_type == 'task'" data-hotkey="v"/>
                    <button name="action_approve" type="object" string="Complete" class="btn-primary"
                            invisible="not is_my_turn or current_step_type != 'task'" data-hotkey="v"/>
                    <button name="action_reject" type="object" string="Reject"
                            invisible="not is_my_turn or current_step_type == 'task'" data-hotkey="z"/>
                    <button name="action_cancel" type="object" string="Cancel Run"
                            invisible="state != 'pending'" confirm="Cancel this run?"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,approved"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_record" type="object" class="oe_stat_button" icon="fa-external-link">
                            <div class="o_stat_info"><span class="o_stat_text">Open the Record</span></div>
                        </button>
                    </div>
                    <field name="is_my_turn" invisible="1"/>
                    <field name="current_step_type" invisible="1"/>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                        <h2><field name="record_name"/></h2>
                    </div>
                    <group>
                        <group>
                            <field name="flow_id"/>
                            <field name="current_step_id" invisible="not current_step_id"/>
                            <field name="wait_until" invisible="not wait_until"/>
                        </group>
                        <group>
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="date_start"/>
                            <field name="date_done" invisible="not date_done"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Flow" name="trail">
                            <field name="flow_trail" invisible="1"/>
                            <widget name="angels_flow_trail"/>
                        </page>
                        <page string="Steps" name="steps">
                            <field name="step_ids">
                                <list decoration-muted="state in ('skipped', 'notified')" decoration-bf="state == 'pending'">
                                    <field name="name"/>
                                    <field name="step_type"/>
                                    <field name="user_ids" widget="many2many_avatar_user"/>
                                    <field name="approved_by_ids" widget="many2many_avatar_user" optional="show"/>
                                    <field name="comment" optional="show"/>
                                    <field name="date_done"/>
                                    <field name="date_deadline" optional="show" decoration-danger="is_late"/>
                                    <field name="is_late" column_invisible="1"/>
                                    <field name="state" widget="badge" decoration-info="state == 'pending'"
                                           decoration-success="state in ('approved', 'done')"
                                           decoration-warning="state == 'expired'"
                                           decoration-danger="state == 'rejected'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_run_search" model="ir.ui.view">
        <field name="name">angels.flow.run.search</field>
        <field name="model">angels.flow.run</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="record_name"/>
                <field name="flow_id"/>
                <filter name="my_turn" string="Waiting for Me" domain="[('is_my_turn', '=', True)]"/>
                <filter name="running" string="Running" domain="[('state', '=', 'pending')]"/>
                <filter name="waiting" string="Waiting" domain="[('wait_until', '!=', False)]"/>
                <separator/>
                <filter name="done" string="Over" domain="[('state', 'in', ('approved', 'rejected', 'cancelled'))]"/>
                <group>
                    <filter name="by_flow" string="Flow" context="{'group_by': 'flow_id'}"/>
                    <filter name="by_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_run_to_do" model="ir.actions.act_window">
        <field name="name">To Do</field>
        <field name="res_model">angels.flow.run</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_my_turn', '=', True)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing waits for you</p>
            <p>The approvals and tasks of the flows that reach you show here.</p>
        </field>
    </record>

    <record id="action_run_all" model="ir.actions.act_window">
        <field name="name">Runs</field>
        <field name="res_model">angels.flow.run</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_running': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No run yet</p>
            <p>Each time a record starts a flow, its run shows here with its steps and history.</p>
        </field>
    </record>

    <record id="view_decision_wizard_form" model="ir.ui.view">
        <field name="name">angels.flow.decision.wizard.form</field>
        <field name="model">angels.flow.decision.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="run_id" invisible="1"/>
                <field name="decision" invisible="1"/>
                <field name="step_type" invisible="1"/>
                <field name="comment" required="decision == 'reject'" placeholder="Add a comment"/>
                <footer>
                    <button name="action_confirm" type="object" string="Approve" class="btn-primary"
                            invisible="decision != 'approve' or step_type == 'task'" data-hotkey="q"/>
                    <button name="action_confirm" type="object" string="Mark as Done" class="btn-primary"
                            invisible="decision != 'approve' or step_type != 'task'" data-hotkey="q"/>
                    <button name="action_confirm" type="object" string="Reject" class="btn-danger"
                            invisible="decision != 'reject'" data-hotkey="q"/>
                    <button special="cancel" string="Discard" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
