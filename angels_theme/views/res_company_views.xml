<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_angels_theme" model="ir.ui.view">
        <field name="name">res.company.form.angels_theme</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Appearance" name="angels_theme">
                    <group>
                        <group>
                            <field name="angels_home_background" widget="radio"/>
                            <field name="angels_home_image" widget="image"
                                invisible="angels_home_background != 'image'"
                                options="{'size': [240, 135]}"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
