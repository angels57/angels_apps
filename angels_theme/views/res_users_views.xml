<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_simple_modif_angels_theme" model="ir.ui.view">
        <field name="name">res.users.preferences.form.angels_theme</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form_simple_modif"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='preferences_page']/group" position="after">
                <group name="angels_theme" string="Appearance">
                    <group>
                        <field name="angels_theme_density" widget="radio" options="{'horizontal': true}" readonly="0"/>
                        <field name="angels_theme_tab_style" widget="radio" options="{'horizontal': true}" readonly="0"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_users_form_angels_theme" model="ir.ui.view">
        <field name="name">res.users.form.angels_theme</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='preferences']/group" position="after">
                <group name="angels_theme" string="Appearance">
                    <group>
                        <field name="angels_theme_density" widget="radio" options="{'horizontal': true}"/>
                        <field name="angels_theme_tab_style" widget="radio" options="{'horizontal': true}"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
