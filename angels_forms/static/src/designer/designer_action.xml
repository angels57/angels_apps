<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="angels_forms.DesignerAction">
        <div class="o_action o_af_designer">
            <div t-if="this.data" class="o_af_topbar">
                <div class="o_af_titles">
                    <div class="o_af_crumbs">
                        <t t-foreach="this.breadcrumbs" t-as="crumb" t-key="crumb_index">
                            <a href="#" t-on-click.prevent="() => crumb.onSelected()" t-out="crumb.name"/>
                            <span class="o_af_sep">/</span>
                        </t>
                        <span>Designer</span>
                    </div>
                    <input type="text" class="o_af_name_input" aria-label="Form name"
                           t-att-value="this.data.form.name"
                           t-on-change="(ev) => this.setFormProp('name', ev.target.value)"/>
                </div>
                <div class="o_af_tabs" role="tablist">
                    <button type="button" role="tab" t-att-aria-selected="this.state.tab === 'fields'"
                            t-att-class="{'active': this.state.tab === 'fields'}" t-on-click="() => this.setTab('fields')">
                        <i class="fa fa-list-alt" aria-hidden="true"/>
                        <span>Questions</span>
                        <span class="o_af_count" t-out="this.questions.length"/>
                    </button>
                    <button type="button" role="tab" t-att-aria-selected="this.state.tab === 'flow'"
                            t-att-class="{'active': this.state.tab === 'flow'}" t-on-click="() => this.setTab('flow')">
                        <i class="fa fa-code-fork" aria-hidden="true"/>
                        <span>Flow</span>
                        <span class="o_af_count" t-out="this.nodes.length - 1"/>
                    </button>
                </div>
                <div class="o_af_actions">
                    <span t-if="this.state.dirty" class="o_af_unsaved">Unsaved changes</span>
                    <button type="button" class="btn btn-secondary" t-on-click="() => this.togglePublished()">
                        <t t-if="this.data.form.published">
                            <i class="fa fa-circle text-success me-1" aria-hidden="true"/>Published
                        </t>
                        <t t-else="">
                            <i class="fa fa-circle-o me-1" aria-hidden="true"/>Publish
                        </t>
                    </button>
                    <button type="button" class="btn btn-primary" t-att-disabled="!this.state.dirty or this.state.saving"
                            t-on-click="() => this.save()">Save</button>
                </div>
            </div>
            <div t-if="this.data" class="o_af_body">
                <t t-if="this.state.tab === 'fields'" t-call="angels_forms.DesignerFields"/>
                <FlowEditor t-else="" t-key="this.state.version"
                            nodes="this.data.nodes" fields="this.data.fields" labels="this.labels"
                            ports="this.data.ports" operatorsByType="this.data.operators_by_type"
                            names="this.state.names" loadNames="(model, ids) => this.loadNames(model, ids)"
                            conditionsText="(item) => this.conditionsText(item)" onChange="() => this.touch()"/>
            </div>
        </div>
    </t>

    <!-- Questions tab: palette | canvas | properties -->
    <t t-name="angels_forms.DesignerFields">
        <aside class="o_af_palette">
            <h6>Add a question</h6>
            <p class="text-muted small">Click a type, or drag it onto the form.</p>
            <button t-foreach="this.palette" t-as="item" t-key="item.type" type="button"
                    class="o_af_palette_item" t-on-pointerdown="(ev) => this.onPalettePointerDown(item, ev)">
                <i t-attf-class="fa fa-fw #{item.icon}" aria-hidden="true"/>
                <span t-out="item.label"/>
            </button>
            <h6 class="mt-4">Form</h6>
            <label class="form-label small" for="o_af_form_description">Description</label>
            <textarea id="o_af_form_description" class="form-control form-control-sm" rows="3"
                      t-att-value="this.data.form.description"
                      t-on-change="(ev) => this.setFormProp('description', ev.target.value)"/>
            <label class="form-label small mt-2" for="o_af_form_icon">Icon</label>
            <div class="input-group input-group-sm">
                <span class="input-group-text"><i t-attf-class="fa fa-fw #{this.data.form.icon or 'fa-file-text-o'}" aria-hidden="true"/></span>
                <input id="o_af_form_icon" type="text" class="form-control" placeholder="fa-plane"
                       t-att-value="this.data.form.icon"
                       t-on-change="(ev) => this.setFormProp('icon', ev.target.value.trim())"/>
            </div>
        </aside>

        <main class="o_af_canvas">
            <div class="o_af_canvas_bar">
                <div class="o_af_mode" role="tablist" aria-label="Mode">
                    <button type="button" role="tab" t-att-aria-selected="this.state.mode === 'design'"
                            t-att-class="{'active': this.state.mode === 'design'}" t-on-click="() => this.setMode('design')">
                        <i class="fa fa-pencil" aria-hidden="true"/><span>Design</span>
                    </button>
                    <button type="button" role="tab" t-att-aria-selected="this.state.mode === 'test'"
                            t-att-class="{'active': this.state.mode === 'test'}" t-on-click="() => this.setMode('test')">
                        <i class="fa fa-play" aria-hidden="true"/><span>Test</span>
                    </button>
                </div>
                <t t-if="this.state.mode === 'test'">
                    <label class="small text-muted ms-2" for="o_af_preview_as">As</label>
                    <select id="o_af_preview_as" class="form-select form-select-sm w-auto"
                            t-on-change="(ev) => this.setPreviewAs(ev.target.value)">
                        <option value="requester" t-att-selected="this.state.previewAs === 'requester'">The requester</option>
                        <t t-foreach="this.stages" t-as="stage" t-key="stage.id">
                            <option t-att-value="stage.id" t-att-selected="this.isPreviewAs(stage)" t-out="stage.name"/>
                        </t>
                    </select>
                    <button type="button" class="btn btn-sm btn-light" t-on-click="() => this.resetPreview()">
                        <i class="fa fa-undo me-1" aria-hidden="true"/>Clear Answers
                    </button>
                    <span class="small text-muted ms-auto">Try the conditions. Nothing is saved.</span>
                </t>
                <span t-else="" class="small text-muted ms-auto">Drag questions anywhere on the grid.</span>
            </div>

            <div t-if="this.state.mode === 'design'" class="o_af_paper">
                <div t-if="!this.fields.length" class="o_af_canvas_empty">
                    <i class="fa fa-hand-pointer-o fa-2x mb-2" aria-hidden="true"/>
                    <p>Drag a question type here, or click it in the palette.</p>
                </div>
                <div t-ref="grid" t-attf-class="o_af_grid #{this.state.dragging or this.state.target ? 'o_af_grid_dragging' : ''}">
                    <div class="o_af_grid_cols" aria-hidden="true">
                        <span t-foreach="this.columns" t-as="column" t-key="column"/>
                    </div>
                    <div t-foreach="this.fields" t-as="field" t-key="field.id" t-att-class="this.cardClass(field)"
                         t-att-style="this.cardStyle(field)" t-att-data-field-id="field.id" t-att-data-row="field.row"
                         tabindex="0" t-on-pointerdown="(ev) => this.onCardPointerDown(field, ev)"
                         t-on-keydown="(ev) => ev.key === 'Enter' and this.select(field)">
                        <t t-set="stage" t-value="this.stageOf(field)"/>
                        <t t-set="isSelected" t-value="field.id === this.state.selectedId"/>
                        <div t-if="isSelected" t-attf-class="o_af_toolbar #{field.col >= 6 ? 'o_af_toolbar_end' : ''}"
                             role="toolbar" aria-label="Question options">
                            <button t-if="field.type !== 'section'" type="button"
                                    t-attf-class="o_af_tool #{field.required ? 'active' : ''}" title="Required"
                                    aria-label="Required" t-on-click="() => this.setProp(field, 'required', !field.required)">
                                <i class="fa fa-asterisk" aria-hidden="true"/>
                            </button>
                            <div t-if="field.type !== 'section'" class="o_af_tool_group" role="group" aria-label="Width">
                                <t t-foreach="this.widthKeys" t-as="width" t-key="width">
                                    <button type="button" t-attf-class="o_af_tool #{field.width === width ? 'active' : ''}"
                                            t-att-title="this.labels.widths[width]"
                                            t-on-click="() => this.setWidth(field, width)" t-out="this.widthLabel(width)"/>
                                </t>
                            </div>
                            <select class="o_af_tool_select" aria-label="Type"
                                    t-on-change="(ev) => this.setProp(field, 'type', ev.target.value)">
                                <t t-foreach="this.palette" t-as="item" t-key="item.type">
                                    <option t-att-value="item.type" t-att-selected="item.type === field.type" t-out="item.label"/>
                                </t>
                            </select>
                            <button type="button" t-attf-class="o_af_tool #{field.conditions.length ? 'active' : ''}"
                                    title="Show only if" aria-label="Show only if" t-on-click="() => this.showConditions()">
                                <i class="fa fa-code-fork" aria-hidden="true"/>
                            </button>
                            <button type="button" class="o_af_tool" title="Duplicate" aria-label="Duplicate"
                                    t-on-click="() => this.duplicate(field)">
                                <i class="fa fa-clone" aria-hidden="true"/>
                            </button>
                            <button type="button" class="o_af_tool o_af_tool_danger" title="Delete" aria-label="Delete"
                                    t-on-click="() => this.removeField(field)">
                                <i class="fa fa-trash-o" aria-hidden="true"/>
                            </button>
                        </div>
                        <div class="o_af_card_head">
                            <span class="o_af_grip" aria-hidden="true"><i class="fa fa-ellipsis-v"/><i class="fa fa-ellipsis-v"/></span>
                            <span class="o_af_card_icon"><i t-attf-class="fa fa-fw #{this.fieldIcon(field)}" aria-hidden="true"/></span>
                            <input t-if="isSelected" type="text" class="o_af_title_input" aria-label="Label"
                                   t-att-value="field.name" t-on-input="(ev) => this.setProp(field, 'name', ev.target.value)"/>
                            <span t-else="" class="o_af_card_title" t-out="field.name"/>
                            <span t-if="field.required" class="text-danger" aria-label="Required">*</span>
                        </div>
                        <t t-call="angels_forms.FieldMock"/>
                        <div class="o_af_card_meta">
                            <span t-if="stage" t-attf-class="o_af_stage o_af_stage_#{stage.color % 12}">
                                <i class="fa fa-pencil me-1" aria-hidden="true"/><t t-out="stage.name"/>
                            </span>
                            <span t-if="this.data.form.title_field_id === field.id" class="o_af_badge">
                                <i class="fa fa-tag me-1" aria-hidden="true"/>Title
                            </span>
                            <span t-if="field.conditions.length" class="o_af_badge o_af_badge_condition"
                                  t-att-title="this.conditionsText(field)">
                                <i class="fa fa-code-fork me-1" aria-hidden="true"/>
                                <t t-out="this.conditionsText(field)"/>
                            </span>
                            <span t-if="this.brokenConditions(field).length" class="o_af_badge o_af_badge_warning">
                                <i class="fa fa-exclamation-triangle me-1" aria-hidden="true"/>Check the conditions
                            </span>
                        </div>
                        <span t-if="field.type !== 'section'" class="o_af_resize" title="Drag to change the width"
                              t-on-pointerdown="(ev) => this.onResizePointerDown(field, ev)"/>
                    </div>
                    <div t-if="this.state.target" t-attf-class="o_af_target #{this.state.target.insert ? 'o_af_target_line' : ''}"
                         t-att-style="this.targetStyle"/>
                    <div t-if="this.state.dragging" class="o_af_end_row"
                         t-att-style="this.endRowStyle">
                        <i class="fa fa-plus me-1" aria-hidden="true"/>New row
                    </div>
                </div>
                <p t-if="this.fields.length" class="o_af_shortcuts">
                    Drop a question beside another one to share the row, between rows for a new row, or leave
                    empty columns. Stretch its right edge to resize it. Keys: arrows to move, Delete, Ctrl+D to duplicate.
                </p>
            </div>

            <div t-else="" class="o_af_test">
                <div class="o_af_fill_card">
                    <div class="o_af_fill_header">
                        <span class="o_af_fill_icon">
                            <i t-attf-class="fa fa-fw #{this.data.form.icon or 'fa-file-text-o'}" aria-hidden="true"/>
                        </span>
                        <div>
                            <h2 class="mb-1" t-out="this.data.form.name"/>
                            <p t-if="this.data.form.description" class="text-muted mb-0" t-out="this.data.form.description"/>
                        </div>
                    </div>
                    <FormRenderer t-key="this.state.previewKey" fields="this.previewFields" values="this.preview"/>
                </div>
            </div>
        </main>

        <aside class="o_af_inspector">
            <t t-if="this.selected">
                <t t-set="field" t-value="this.selected"/>
                <h6>Question</h6>
                <label class="form-label small" for="o_af_prop_name">Label</label>
                <input id="o_af_prop_name" type="text" class="form-control form-control-sm"
                       t-att-value="field.name" t-on-input="(ev) => this.setProp(field, 'name', ev.target.value)"/>

                <label class="form-label small mt-2" for="o_af_prop_type">Type</label>
                <select id="o_af_prop_type" class="form-select form-select-sm"
                        t-on-change="(ev) => this.setProp(field, 'type', ev.target.value)">
                    <t t-foreach="this.palette" t-as="item" t-key="item.type">
                        <option t-att-value="item.type" t-att-selected="item.type === field.type" t-out="item.label"/>
                    </t>
                </select>

                <t t-if="field.type !== 'section'">
                    <div class="form-check form-switch mt-3">
                        <input id="o_af_prop_required" type="checkbox" class="form-check-input" role="switch"
                               t-att-checked="field.required"
                               t-on-change="(ev) => this.setProp(field, 'required', ev.target.checked)"/>
                        <label class="form-check-label" for="o_af_prop_required">Required</label>
                    </div>
                    <div t-if="this.canBeTitle(field)" class="form-check form-switch">
                        <input id="o_af_prop_title" type="checkbox" class="form-check-input" role="switch"
                               t-att-checked="this.data.form.title_field_id === field.id"
                               t-on-change="(ev) => this.setTitle(field, ev.target.checked)"/>
                        <label class="form-check-label" for="o_af_prop_title">Name requests with this answer</label>
                    </div>
                    <div class="mt-2">
                        <span class="form-label small d-block">Width</span>
                        <div class="btn-group btn-group-sm o_af_widths" role="group" aria-label="Width">
                            <t t-foreach="this.widthKeys" t-as="width" t-key="width">
                                <button type="button" t-att-class="'btn ' + (field.width === width ? 'btn-primary' : 'btn-secondary')"
                                        t-on-click="() => this.setWidth(field, width)"
                                        t-out="this.widthLabel(width)"/>
                            </t>
                        </div>
                    </div>
                </t>

                <label class="form-label small mt-3" for="o_af_prop_stage">Filled by</label>
                <select id="o_af_prop_stage" class="form-select form-select-sm"
                        t-on-change="(ev) => this.setStage(field, ev.target.value)">
                    <option value="" t-att-selected="!field.node_id">The requester</option>
                    <t t-foreach="this.stages" t-as="stage" t-key="stage.id">
                        <option t-att-value="stage.id" t-att-selected="stage.id === field.node_id" t-out="stage.name"/>
                    </t>
                </select>
                <p t-if="!this.stages.length" class="text-muted small mt-1 mb-0">
                    Add an Approval or Task step in the Flow tab to let its people fill questions.
                </p>

                <t t-if="this.hasPlaceholder(field)">
                    <label class="form-label small mt-2" for="o_af_prop_placeholder">Placeholder</label>
                    <input id="o_af_prop_placeholder" type="text" class="form-control form-control-sm"
                           t-att-value="field.placeholder"
                           t-on-input="(ev) => this.setProp(field, 'placeholder', ev.target.value)"/>
                </t>
                <label class="form-label small mt-2" for="o_af_prop_help">Help text</label>
                <input id="o_af_prop_help" type="text" class="form-control form-control-sm"
                       t-att-value="field.help" t-on-input="(ev) => this.setProp(field, 'help', ev.target.value)"/>

                <t t-if="field.type === 'selection'">
                    <h6 class="mt-4">Choices</h6>
                    <div t-foreach="field.options" t-as="option" t-key="option_index" class="d-flex gap-1 mb-1">
                        <input type="text" class="form-control form-control-sm" t-att-value="option"
                               t-att-aria-label="'Choice ' + (option_index + 1)"
                               t-on-input="(ev) => this.setOption(field, option_index, ev.target.value)"/>
                        <button type="button" class="btn btn-sm btn-link text-danger" title="Remove choice"
                                aria-label="Remove choice" t-on-click="() => this.removeOption(field, option_index)">
                            <i class="fa fa-times" aria-hidden="true"/>
                        </button>
                    </div>
                    <button type="button" class="btn btn-sm btn-secondary" t-on-click="() => this.addOption(field)">
                        <i class="fa fa-plus me-1" aria-hidden="true"/>Add Choice
                    </button>
                </t>

                <h6 class="mt-4 o_af_conditions_anchor">Show only if</h6>
                <div t-if="this.brokenConditions(field).length" class="alert alert-warning small py-2">
                    A condition uses a question that is now placed after this one. Change or remove it.
                </div>
                <ConditionEditor t-key="field.id" item="field" sources="this.sourcesFor(field)"
                                 labels="this.labels.operators" operatorsByType="this.data.operators_by_type"
                                 onChange="() => this.touch()"
                                 emptyText.translate="Always shown."/>
            </t>
            <div t-else="" class="o_af_inspector_empty">
                <i class="fa fa-mouse-pointer fa-2x mb-2" aria-hidden="true"/>
                <p>Select a question to change its label, type, choices and conditions.</p>
            </div>
        </aside>
    </t>

    <!-- How a question will look, drawn on its card in the designer -->
    <t t-name="angels_forms.FieldMock">
        <t t-set="kind" t-value="this.mockKind(field)"/>
        <div t-if="kind" class="o_af_mock" aria-hidden="true">
            <div t-if="kind === 'input' or kind === 'select'" class="o_af_mock_input">
                <span t-out="this.mockHint(field)"/>
                <i t-attf-class="fa #{kind === 'select' ? 'fa-caret-down' : this.fieldIcon(field)}"/>
            </div>
            <div t-elif="kind === 'area'" class="o_af_mock_input o_af_mock_area">
                <span t-out="field.placeholder"/>
            </div>
            <div t-elif="kind === 'switch'" class="o_af_mock_switch"><span class="o_af_mock_toggle"/><span>Yes / No</span></div>
            <div t-elif="kind === 'choices'" class="o_af_mock_choices">
                <span t-foreach="field.options" t-as="option" t-key="option_index" t-out="option"/>
            </div>
            <div t-elif="kind === 'file'" class="o_af_mock_file"><i class="fa fa-paperclip me-1"/>Add files</div>
            <div t-if="field.help" class="o_af_mock_help" t-out="field.help"/>
        </div>
    </t>

</templates>
