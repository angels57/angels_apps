<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_angels_forms" model="ir.module.category">
        <field name="name">Angels Forms</field>
        <field name="sequence">62</field>
    </record>

    <record id="res_groups_privilege_angels_forms" model="res.groups.privilege">
        <field name="name">Angels Forms</field>
        <field name="category_id" ref="module_category_angels_forms"/>
        <field name="sequence">62</field>
    </record>

    <record id="group_form_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="res_groups_privilege_angels_forms"/>
        <field name="sequence">10</field>
    </record>

    <record id="group_form_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="privilege_id" ref="res_groups_privilege_angels_forms"/>
        <field name="sequence">20</field>
        <field name="implied_ids" eval="[(4, ref('angels_forms.group_form_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- Every internal user can fill forms. -->
    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('angels_forms.group_form_user'))]"/>
    </record>

</odoo>
