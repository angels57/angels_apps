<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sign_request_item_form_sms" model="ir.ui.view">
        <field name="name">sign.request.item.form.sms</field>
        <field name="model">sign.request.item</field>
        <field name="inherit_id" ref="easy_sign.view_sign_request_item_form"/>
        <field name="arch" type="xml">
            <field name="signer_email" position="after">
                <field name="signer_phone" required="auth_method == 'sms_otp'"/>
            </field>
        </field>
    </record>
</odoo>
