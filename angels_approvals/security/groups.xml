<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_angels_approvals" model="ir.module.category">
        <field name="name">Angels Approvals</field>
        <field name="sequence">61</field>
    </record>

    <record id="res_groups_privilege_angels_approvals" model="res.groups.privilege">
        <field name="name">Angels Approvals</field>
        <field name="category_id" ref="module_category_angels_approvals"/>
        <field name="sequence">61</field>
    </record>

    <record id="group_approval_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="res_groups_privilege_angels_approvals"/>
        <field name="sequence">10</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_approval_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="privilege_id" ref="res_groups_privilege_angels_approvals"/>
        <field name="sequence">20</field>
        <field name="implied_ids" eval="[(4, ref('angels_approvals.group_approval_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

</odoo>
