<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.easy.sign.certificate</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="easy_sign.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='sign_certificate']" position="inside">
                <div class="content-group mt8" invisible="not module_easy_sign_certificate">
                    <div class="row">
                        <label for="signing_certificate_id" string="Signing certificate" class="col-lg-4 o_light_label"/>
                        <field name="signing_certificate_id" options="{'no_create': True}"/>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
