<?xml version="1.0" encoding="utf-8"?>
<odoo>


<template id="sign_page" name="Easy Sign - Sign Document">
<html lang="en" id="esRoot">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <meta name="robots" content="noindex, nofollow"/>
    <title>Sign Document - Easy Sign</title>
    <t t-call-assets="easy_sign.assets_sign_page" t-js="false"/>
</head>
<body class="es-body">

    <!-- Navbar -->
    <nav class="es-navbar">
        <div class="es-navbar-brand">
            <span class="es-logo-icon">&#9998;</span>
            <span class="es-logo-text">Easy Sign</span>
        </div>
        <div class="es-navbar-right">
            <span class="es-badge es-badge-pending">
                <span class="es-i18n" data-en="Signature Required" data-ar="يلزم التوقيع">Signature Required</span>
            </span>
            <!-- Language Switch Button -->
            <button type="button" class="es-lang-btn" id="esBtnLang">
                <span class="es-lang-flag">🌐</span>
                <span id="esLangLabel">عربي</span>
            </button>
        </div>
    </nav>

    <div class="es-container">
        <div class="es-main-row">

            <!-- Left: PDF Viewer -->
            <div class="es-pdf-panel">
                <div class="es-panel-header">
                    <div class="es-panel-title">
                        <span class="es-icon">📄</span>
                        <span class="es-i18n" data-en="Document to Sign" data-ar="الوثيقة المطلوب توقيعها">Document to Sign</span>
                    </div>
                    <div class="es-doc-info">
                        <strong t-out="sign_request.document_name or sign_request.name"/>
                    </div>
                </div>
                <div class="es-pdf-viewer-wrap">
                    <object t-att-data="document_url" type="application/pdf"
                            class="es-pdf-object" id="pdfViewer">
                        <div class="es-pdf-fallback">
                            <p class="es-i18n" data-en="Your browser cannot display PDF inline." data-ar="المتصفح لا يدعم عرض PDF مباشرة.">Your browser cannot display PDF inline.</p>
                            <a t-att-href="document_url" class="es-btn-outline" target="_blank">
                                <span class="es-i18n" data-en="Open PDF in New Tab" data-ar="فتح الملف في تبويب جديد">Open PDF in New Tab</span>
                            </a>
                        </div>
                    </object>
                </div>
            </div>

            <div class="es-sign-panel">
                <div class="es-sign-panel-inner">

                    <div class="es-signer-info">
                        <div class="es-avatar">
                            <t t-out="(item.signer_name or 'S')[0].upper()"/>
                        </div>
                        <div class="es-signer-details">
                            <div class="es-signer-name" t-out="item.signer_name"/>
                            <div class="es-signer-email" t-out="item.signer_email"/>
                        </div>
                    </div>

                    <div class="es-request-info">
                        <p class="es-info-label es-i18n" data-en="Requested by" data-ar="طلب من">Requested by</p>
                        <p class="es-info-value" t-out="sign_request.user_id.name"/>
                        <t t-if="sign_request.expiry_date">
                            <p class="es-info-label es-i18n" data-en="Expires on" data-ar="تنتهي في">Expires on</p>
                            <p class="es-info-value es-expiry" t-out="sign_request.expiry_date"/>
                        </t>
                    </div>

                    <div class="es-instructions">
                        <h5 class="es-section-title es-i18n" data-en="Draw Your Signature" data-ar="ارسم توقيعك">Draw Your Signature</h5>
                        <p class="es-instructions-text es-i18n"
                           data-en="Please review the document on the left, then draw your signature in the box below using your mouse or finger."
                           data-ar="يرجى مراجعة الوثيقة، ثم ارسم توقيعك في المربع أدناه باستخدام الماوس أو إصبعك.">
                            Please review the document on the left, then draw your signature in the box below using your mouse or finger.
                        </p>
                    </div>

                    <div class="es-canvas-wrap">
                        <canvas id="signatureCanvas" width="480" height="180" class="es-canvas"/>
                        <div class="es-canvas-hint es-i18n" data-en="Sign here ✍" data-ar="وقّع هنا ✍">Sign here ✍</div>
                    </div>

                    <div class="es-canvas-controls">
                        <button id="btnClear" type="button" class="es-btn-clear">
                            &#8634; <span class="es-i18n" data-en="Clear" data-ar="مسح">Clear</span>
                        </button>
                        <span id="canvasStatus" class="es-canvas-status"/>
                    </div>

                    <button id="btnSign" type="button" t-att-data-csrf="csrf_token" class="es-btn-sign" t-att-data-token="token">
                        <span id="btnSignText">
                            &#10003; <span class="es-i18n" data-en="Sign Document" data-ar="توقيع الوثيقة">Sign Document</span>
                        </span>
                        <span id="btnSignSpinner" class="es-hidden">
                            <span class="es-spinner" role="status"/>
                            <span class="es-i18n" data-en="Submitting..." data-ar="جاري الإرسال...">Submitting...</span>
                        </span>
                    </button>

                    <div class="es-decline-section">
                        <button id="btnShowDecline" type="button" class="es-btn-decline-link">
                            <span class="es-i18n" data-en="I decline to sign this document" data-ar="أرفض التوقيع على هذه الوثيقة">I decline to sign this document</span>
                        </button>
                    </div>

                    <div id="declineForm" class="es-decline-form es-hidden">
                        <h6 class="es-section-title es-i18n" data-en="Reason for Declining" data-ar="سبب الرفض">Reason for Declining</h6>
                        <textarea id="declineReason" rows="3" class="es-textarea" placeholder="Optional: provide a reason..."></textarea>
                        <div class="es-decline-actions">
                            <button id="btnCancelDecline" type="button" class="es-btn-cancel-decline">
                                <span class="es-i18n" data-en="Cancel" data-ar="إلغاء">Cancel</span>
                            </button>
                            <button id="btnConfirmDecline" type="button" t-att-data-csrf="csrf_token" class="es-btn-confirm-decline" t-att-data-token="token">
                                <span class="es-i18n" data-en="Confirm Decline" data-ar="تأكيد الرفض">Confirm Decline</span>
                            </button>
                        </div>
                    </div>

                    <!-- Messages -->
                    <div id="msgSuccess" class="es-msg es-msg-success es-hidden">
                        <span class="es-msg-icon">&#10004;</span>
                        <div>
                            <strong class="es-i18n" data-en="Signed successfully!" data-ar="تم التوقيع بنجاح!">Signed successfully!</strong>
                            <p class="es-i18n" data-en="Thank you. The document has been signed." data-ar="شكراً. تم توقيع الوثيقة.">Thank you. The document has been signed.</p>
                        </div>
                    </div>
                    <div id="msgError" class="es-msg es-msg-error es-hidden">
                        <span class="es-msg-icon">&#9888;</span>
                        <div>
                            <strong class="es-i18n" data-en="Error" data-ar="خطأ">Error</strong>
                            <p id="msgErrorText"/>
                        </div>
                    </div>
                    <div id="msgDeclined" class="es-msg es-msg-declined es-hidden">
                        <span class="es-msg-icon">&#10005;</span>
                        <div>
                            <strong class="es-i18n" data-en="Signing declined" data-ar="تم رفض التوقيع">Signing declined</strong>
                            <p class="es-i18n" data-en="The requester has been notified." data-ar="تم إشعار مقدم الطلب.">The requester has been notified.</p>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>

    <footer class="es-footer">
        <span class="es-i18n" data-en="Secured by" data-ar="مؤمّن بواسطة">Secured by</span>
        <strong> Easy Sign</strong>
    </footer>

    <t t-call-assets="easy_sign.assets_sign_page" t-css="false"/>
</body>
</html>
</template>


<!-- ═══════════════════════════════════════════════════
     SUCCESS PAGE
═══════════════════════════════════════════════════ -->
<template id="sign_success" name="Easy Sign - Signing Success">
<html lang="en" id="esRoot">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <title>Document Signed - Easy Sign</title>
    <t t-call-assets="easy_sign.assets_sign_page" t-js="false"/>
</head>
<body class="es-body es-result-body">
    <div class="es-result-card es-result-success">
        <div class="es-result-icon">&#10004;</div>

        <button type="button" class="es-lang-btn">
            🌐 <span id="esLangLabel">عربي</span>
        </button>

        <h2 class="es-result-title">
            <t t-if="already_done">
                <span class="es-i18n" data-en="Already Signed" data-ar="تم التوقيع مسبقاً">Already Signed</span>
            </t>
            <t t-else="">
                <span class="es-i18n" data-en="Document Signed!" data-ar="تم توقيع الوثيقة!">Document Signed!</span>
            </t>
        </h2>
        <p class="es-result-message">
            <t t-if="already_done">
                <span class="es-i18n" data-en="You have already signed this document. Thank you!" data-ar="لقد وقّعت على هذه الوثيقة مسبقاً. شكراً!">You have already signed this document. Thank you!</span>
            </t>
            <t t-else="">
                <span class="es-i18n" data-en="Thank you" data-ar="شكراً">Thank you</span>,
                <strong t-out="item.signer_name"/>!
                <span class="es-i18n" data-en="Your signature has been recorded successfully." data-ar="تم تسجيل توقيعك بنجاح.">Your signature has been recorded successfully.</span>
            </t>
        </p>
        <t t-if="item and item.signed_date">
            <p class="es-result-meta">
                <span class="es-i18n" data-en="Signed on:" data-ar="تاريخ التوقيع:">Signed on:</span>
                <strong t-out="item.signed_date"/>
            </p>
        </t>
        <div class="es-result-footer">
            <span class="es-i18n" data-en="Secured by" data-ar="مؤمّن بواسطة">Secured by</span>
            <strong> Easy Sign</strong>
        </div>
    </div>
    <t t-call-assets="easy_sign.assets_sign_page" t-css="false"/>
</body>
</html>
</template>


<!-- ═══════════════════════════════════════════════════
     DECLINED PAGE
═══════════════════════════════════════════════════ -->
<template id="sign_declined" name="Easy Sign - Signing Declined">
<html lang="en" id="esRoot">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <title>Signing Declined - Easy Sign</title>
    <t t-call-assets="easy_sign.assets_sign_page" t-js="false"/>
</head>
<body class="es-body es-result-body">
    <div class="es-result-card es-result-declined">
        <div class="es-result-icon">&#10005;</div>

        <button type="button" class="es-lang-btn">
            🌐 <span id="esLangLabel">عربي</span>
        </button>

        <h2 class="es-result-title">
            <span class="es-i18n" data-en="Signing Declined" data-ar="تم رفض التوقيع">Signing Declined</span>
        </h2>
        <p class="es-result-message">
            <t t-if="already_done">
                <span class="es-i18n" data-en="You have already declined to sign this document." data-ar="لقد رفضت التوقيع على هذه الوثيقة مسبقاً.">You have already declined to sign this document.</span>
            </t>
            <t t-else="">
                <span class="es-i18n" data-en="You have declined to sign this document. The requester has been notified." data-ar="لقد رفضت التوقيع على الوثيقة. تم إشعار مقدم الطلب.">You have declined to sign this document. The requester has been notified.</span>
            </t>
        </p>
        <t t-if="item and item.declined_reason">
            <p class="es-result-meta">
                <span class="es-i18n" data-en="Reason:" data-ar="السبب:">Reason:</span>
                <em t-out="item.declined_reason"/>
            </p>
        </t>
        <div class="es-result-footer">
            <span class="es-i18n" data-en="Secured by" data-ar="مؤمّن بواسطة">Secured by</span>
            <strong> Easy Sign</strong>
        </div>
    </div>
    <t t-call-assets="easy_sign.assets_sign_page" t-css="false"/>
</body>
</html>
</template>


<!-- ═══════════════════════════════════════════════════
     INVALID / EXPIRED PAGE
═══════════════════════════════════════════════════ -->
<template id="sign_invalid" name="Easy Sign - Invalid Link">
<html lang="en" id="esRoot">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <title>Invalid Link - Easy Sign</title>
    <t t-call-assets="easy_sign.assets_sign_page" t-js="false"/>
</head>
<body class="es-body es-result-body">
    <div class="es-result-card es-result-invalid">
        <div class="es-result-icon">&#9888;</div>

        <button type="button" class="es-lang-btn">
            🌐 <span id="esLangLabel">عربي</span>
        </button>

        <h2 class="es-result-title" t-out="error_title or 'Invalid Link'"/>
        <p class="es-result-message" t-out="error_message or 'This signing link is invalid or has expired.'"/>
        <div class="es-result-footer">
            <span class="es-i18n" data-en="Secured by" data-ar="مؤمّن بواسطة">Secured by</span>
            <strong> Easy Sign</strong>
        </div>
    </div>
    <t t-call-assets="easy_sign.assets_sign_page" t-css="false"/>
</body>
</html>
</template>

</odoo>
