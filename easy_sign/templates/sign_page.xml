<?xml version="1.0" encoding="utf-8"?>
<odoo>

<template id="sign_pad" name="Easy Sign - Signature Pad">
    <div t-att-class="'es-pad ' + (pad_class or '')" t-att-data-pad="pad_name">
        <div class="es-pad-tabs" role="tablist">
            <button type="button" class="es-pad-tab" data-mode="type"><span class="es-i18n" data-en="Auto" data-ar="تلقائي">Auto</span></button>
            <button type="button" class="es-pad-tab" data-mode="draw"><span class="es-i18n" data-en="Draw" data-ar="ارسم">Draw</span></button>
            <button type="button" class="es-pad-tab" data-mode="upload"><span class="es-i18n" data-en="Upload" data-ar="ارفع صورة">Upload</span></button>
        </div>
        <input type="text" class="es-pad-text es-textarea" maxlength="60" t-att-value="pad_default or ''"
               t-att-aria-label="pad_hint"/>
        <input type="file" class="es-pad-file es-hidden" accept="image/png,image/jpeg"/>
        <div class="es-canvas-wrap">
            <canvas t-att-width="pad_width or 600" t-att-height="pad_height or 200" class="es-canvas"/>
            <div class="es-canvas-hint es-i18n" t-att-data-en="pad_hint" t-att-data-ar="pad_hint_ar" t-out="pad_hint"/>
        </div>
        <div class="es-canvas-controls">
            <button type="button" class="es-btn-clear es-pad-clear">&#8634; <span class="es-i18n" data-en="Clear" data-ar="مسح">Clear</span></button>
            <span class="es-canvas-status es-pad-status"/>
        </div>
    </div>
</template>

<template id="sign_dialog" name="Easy Sign - Dialog">
    <div t-att-id="dialog_id" class="es-dialog es-hidden" role="dialog" aria-modal="true">
        <div class="es-dialog-card">
            <div class="es-dialog-header">
                <h2 class="es-dialog-title es-i18n" t-att-data-en="dialog_title" t-att-data-ar="dialog_title_ar" t-out="dialog_title"/>
                <button type="button" class="es-dialog-close" data-close="1" aria-label="Close">&#215;</button>
            </div>
            <div class="es-dialog-body"><t t-out="0"/></div>
        </div>
    </div>
</template>

<template id="sign_page" name="Easy Sign - Sign Document">
<html lang="en" id="esRoot">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <meta name="robots" content="noindex, nofollow"/>
    <title>Sign Document - Easy Sign</title>
    <t t-call-assets="easy_sign.assets_sign_page" t-js="false"/>
</head>
<body class="es-body es-sign-body">
    <header class="es-topbar">
        <div class="es-topbar-brand">
            <img t-att-src="'/logo.png?company=%s' % sign_request.company_id.id" t-att-alt="sign_request.company_id.name" class="es-company-logo"/>
        </div>
        <div class="es-topbar-doc">
            <strong class="es-topbar-title" t-out="sign_request.document_name or sign_request.name"/>
            <span class="es-topbar-meta">
                <span class="es-i18n" data-en="Requested by" data-ar="طلب من">Requested by</span> <t t-out="sign_request.user_id.name"/>
                <t t-if="sign_request.expiry_date"> · <span class="es-i18n" data-en="Valid until" data-ar="صالح حتى">Valid until</span>
                    <span class="es-expiry" t-out="sign_request.expiry_date"/></t>
            </span>
        </div>
        <div class="es-topbar-right">
            <div class="es-signer-chip">
                <span class="es-signer-name" t-out="item.signer_name"/>
                <span class="es-signer-state">&#9998; <span class="es-i18n" data-en="Signing" data-ar="قيد التوقيع">Signing</span></span>
            </div>
            <button type="button" class="es-lang-btn" id="esBtnLang" aria-label="Language">
                <span class="es-lang-flag">🌐</span>
                <span id="esLangLabel">عربي</span>
            </button>
            <div class="es-menu">
                <button type="button" id="esBtnOptions" class="es-btn-options" aria-haspopup="true" aria-expanded="false">
                    <span class="es-i18n" data-en="Options" data-ar="خيارات">Options</span> &#9662;
                </button>
                <div id="esMenu" class="es-menu-list es-hidden" role="menu">
                    <button type="button" id="btnShowDecline" class="es-menu-item es-menu-danger" role="menuitem">
                        <span class="es-i18n" data-en="Decline to sign" data-ar="رفض التوقيع">Decline to sign</span>
                    </button>
                    <a t-foreach="sign_request.document_ids" t-as="doc" class="es-menu-item" role="menuitem"
                       t-att-href="'/sign/document/%s/%s' % (token, doc.id)" t-att-download="doc.name">
                        <span class="es-i18n" data-en="Download" data-ar="تنزيل">Download</span>
                        <t t-if="len(sign_request.document_ids) &gt; 1"> · <t t-out="doc.name"/></t>
                    </a>
                    <div class="es-menu-info">
                        <span class="es-i18n" data-en="Requested by" data-ar="طلب من">Requested by</span> <t t-out="sign_request.user_id.name"/>
                        <t t-if="sign_request.expiry_date"><br/><span class="es-i18n" data-en="Valid until" data-ar="صالح حتى">Valid until</span>
                            <span class="es-expiry" t-out="sign_request.expiry_date"/></t>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <div class="es-toolbar">
        <div class="es-toolbar-group">
            <button type="button" id="esPrevPage" class="es-tool" aria-label="Previous page">&#8963;</button>
            <input id="esPageInput" class="es-page-input" type="text" inputmode="numeric" value="1" aria-label="Page"/>
            <span class="es-page-total"><span class="es-i18n" data-en="of" data-ar="من">of</span> <span id="esPageCount">1</span></span>
            <button type="button" id="esNextPage" class="es-tool" aria-label="Next page">&#8964;</button>
        </div>
        <div class="es-toolbar-group">
            <button type="button" id="esZoomOut" class="es-tool" aria-label="Zoom out">&#8722;</button>
            <select id="esZoom" class="es-zoom" aria-label="Zoom">
                <option value="auto" class="es-i18n" data-en="Automatic Zoom" data-ar="تكبير تلقائي">Automatic Zoom</option>
                <option value="0.5">50%</option>
                <option value="0.75">75%</option>
                <option value="1">100%</option>
                <option value="1.25">125%</option>
                <option value="1.5">150%</option>
                <option value="2">200%</option>
            </select>
            <button type="button" id="esZoomIn" class="es-tool" aria-label="Zoom in">+</button>
        </div>
    </div>

    <main id="esViewer" class="es-viewer">
        <div id="esPages" class="es-pages" t-att-data-documents="documents_json" t-att-data-fields="fields_json">
            <div class="es-pages-loading es-i18n" data-en="Loading document…" data-ar="جاري تحميل الوثيقة…">Loading document…</div>
        </div>
        <button type="button" id="esRibbon" class="es-ribbon es-hidden">
            <span class="es-i18n" data-en="Click to start" data-ar="انقر للبدء">Click to start</span>
        </button>
    </main>

    <div id="esToast" class="es-toast es-hidden" role="status">
        <div id="msgSuccess" class="es-msg es-msg-success es-hidden">
            <span class="es-msg-icon">&#10004;</span>
            <strong class="es-i18n" data-en="Signed successfully!" data-ar="تم التوقيع بنجاح!">Signed successfully!</strong>
        </div>
        <div id="msgError" class="es-msg es-msg-error es-hidden">
            <span class="es-msg-icon">&#9888;</span>
            <span id="msgErrorText"/>
        </div>
        <div id="msgDeclined" class="es-msg es-msg-declined es-hidden">
            <span class="es-msg-icon">&#10005;</span>
            <strong class="es-i18n" data-en="Signing declined" data-ar="تم رفض التوقيع">Signing declined</strong>
        </div>
    </div>

    <footer class="es-actionbar">
        <span class="es-actionbar-secured">
            <span class="es-i18n" data-en="Secured by" data-ar="مؤمّن بواسطة">Secured by</span> <strong>Easy Sign</strong>
        </span>
        <span id="esProgressText" class="es-progress-text"/>
        <button id="btnSign" type="button" class="es-btn-sign"
                t-att-data-token="token" t-att-data-csrf="csrf_token" t-att-data-otp="needs_otp and '1' or ''"
                t-att-data-signature="needs_signature and '1' or ''">
            <span id="btnSignText">&#10003; <span class="es-i18n" data-en="Sign Document" data-ar="توقيع الوثيقة">Sign Document</span></span>
            <span id="btnSignSpinner" class="es-hidden">
                <span class="es-spinner" role="status"/>
                <span class="es-i18n" data-en="Submitting..." data-ar="جاري الإرسال...">Submitting...</span>
            </span>
        </button>
    </footer>

    <t t-foreach="[('signature', needs_signature), ('initials', needs_initials)]" t-as="kind">
        <t t-if="kind[1]" t-call="easy_sign.sign_dialog">
            <t t-set="dialog_id" t-value="'esDlg_' + kind[0]"/>
            <t t-set="dialog_title" t-value="kind[0] == 'signature' and 'Adopt Your Signature' or 'Adopt Your Initials'"/>
            <t t-set="dialog_title_ar" t-value="kind[0] == 'signature' and 'اعتماد توقيعك' or 'اعتماد الأحرف الأولى'"/>
            <t t-call="easy_sign.sign_pad">
                <t t-set="pad_name" t-value="kind[0]"/>
                <t t-if="kind[0] == 'signature'">
                    <t t-set="pad_hint" t-value="'Sign here ✍'"/>
                    <t t-set="pad_hint_ar" t-value="'وقّع هنا ✍'"/>
                    <t t-set="pad_default" t-value="item.signer_name"/>
                </t>
                <t t-else="">
                    <t t-set="pad_class" t-value="'es-pad-small'"/>
                    <t t-set="pad_width" t-value="300"/>
                    <t t-set="pad_height" t-value="150"/>
                    <t t-set="pad_hint" t-value="'Initials'"/>
                    <t t-set="pad_hint_ar" t-value="'الأحرف الأولى'"/>
                    <t t-set="pad_default" t-value="''.join(w[0] for w in (item.signer_name or '').split() if w).upper()"/>
                </t>
            </t>
            <p class="es-legal es-i18n"
               data-en="By signing, I agree that the chosen signature/initials will be a valid electronic representation of my hand-written signature/initials for all purposes, including legally binding contracts. My IP address, browser and the time of each action are recorded as evidence."
               data-ar="بالتوقيع، أوافق على أن التوقيع أو الأحرف الأولى المختارة تمثيل إلكتروني صالح لتوقيعي الخطي لجميع الأغراض، بما في ذلك العقود الملزمة قانونًا. يتم تسجيل عنوان IP والمتصفح ووقت كل إجراء كدليل.">By signing, I agree that the chosen signature/initials will be a valid electronic representation of my hand-written signature/initials for all purposes, including legally binding contracts. My IP address, browser and the time of each action are recorded as evidence.</p>
            <div class="es-dialog-actions">
                <button type="button" class="es-btn-primary" data-adopt="1">
                    <span class="es-i18n" data-en="Adopt and Sign" data-ar="اعتماد وتوقيع">Adopt and Sign</span>
                </button>
                <button type="button" class="es-btn-secondary" data-close="1">
                    <span class="es-i18n" data-en="Cancel" data-ar="إلغاء">Cancel</span>
                </button>
            </div>
        </t>
    </t>

    <t t-if="needs_otp" t-call="easy_sign.sign_dialog">
        <t t-set="dialog_id" t-value="'esDlgOtp'"/>
        <t t-set="dialog_title" t-value="'Verification Code'"/>
        <t t-set="dialog_title_ar" t-value="'رمز التحقق'"/>
        <p class="es-instructions-text es-i18n" data-en="We sent you a 6-digit code. Enter it to sign."
           data-ar="أرسلنا إليك رمزاً من 6 أرقام. أدخله للتوقيع.">We sent you a 6-digit code. Enter it to sign.</p>
        <input id="esOtpInput" type="text" inputmode="numeric" autocomplete="one-time-code" maxlength="6" class="es-textarea es-otp-input"/>
        <button type="button" id="btnOtpResend" class="es-btn-link">
            <span class="es-i18n" data-en="Send a new code" data-ar="إرسال رمز جديد">Send a new code</span>
        </button>
        <div class="es-dialog-actions">
            <button type="button" id="btnOtpConfirm" class="es-btn-primary">
                <span class="es-i18n" data-en="Confirm and Sign" data-ar="تأكيد وتوقيع">Confirm and Sign</span>
            </button>
            <button type="button" class="es-btn-secondary" data-close="1">
                <span class="es-i18n" data-en="Cancel" data-ar="إلغاء">Cancel</span>
            </button>
        </div>
    </t>

    <t t-call="easy_sign.sign_dialog">
        <t t-set="dialog_id" t-value="'esDlgDecline'"/>
        <t t-set="dialog_title" t-value="'Decline to Sign'"/>
        <t t-set="dialog_title_ar" t-value="'رفض التوقيع'"/>
        <p class="es-instructions-text es-i18n" data-en="The request will be cancelled for everyone. You can tell the sender why."
           data-ar="سيتم إلغاء الطلب للجميع. يمكنك إخبار المرسل بالسبب.">The request will be cancelled for everyone. You can tell the sender why.</p>
        <textarea id="declineReason" rows="3" class="es-textarea" placeholder="Optional: provide a reason..."></textarea>
        <div class="es-dialog-actions">
            <button id="btnConfirmDecline" type="button" class="es-btn-danger" t-att-data-csrf="csrf_token">
                <span class="es-i18n" data-en="Decline" data-ar="رفض">Decline</span>
            </button>
            <button type="button" class="es-btn-secondary" data-close="1">
                <span class="es-i18n" data-en="Cancel" data-ar="إلغاء">Cancel</span>
            </button>
        </div>
    </t>

    <!-- Odoo's pdf.js is an ES module: same loading as web/static/src/core/assets.js -->
    <script type="module" src="/web/static/lib/pdfjs/build/pdf.worker.js"></script>
    <script type="module" src="/web/static/lib/pdfjs/build/pdf.js"></script>
    <t t-call-assets="easy_sign.assets_sign_page" t-css="false"/>
</body>
</html>
</template>

<template id="result_layout" name="Easy Sign - Result Layout">
<html lang="en" id="esRoot">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <meta name="robots" content="noindex, nofollow"/>
    <title t-out="page_title or 'Easy Sign'"/>
    <t t-call-assets="easy_sign.assets_sign_result" t-js="false"/>
</head>
<body class="es-body es-result-body">
    <div t-att-class="'es-result-card ' + (card_class or '')">
        <t t-out="0"/>
        <div class="es-result-footer">
            <span class="es-i18n" data-en="Secured by" data-ar="مؤمّن بواسطة">Secured by</span>
            <strong>Easy Sign</strong>
        </div>
    </div>
    <t t-call-assets="easy_sign.assets_sign_result" t-css="false"/>
</body>
</html>
</template>

<template id="sign_success" name="Easy Sign - Signing Success">
    <t t-call="easy_sign.result_layout">
        <t t-set="page_title" t-value="'Document Signed - Easy Sign'"/>
        <t t-set="card_class" t-value="'es-result-success'"/>
        <div class="es-result-icon">&#10004;</div>
        <button type="button" class="es-lang-btn">🌐 <span id="esLangLabel">عربي</span></button>
        <h2 class="es-result-title">
            <span class="es-i18n" data-en="Document Signed!" data-ar="تم توقيع الوثيقة!">Document Signed!</span>
        </h2>
        <p class="es-result-message">
            <span class="es-i18n" data-en="Thank you. Your signature has been recorded."
                  data-ar="شكراً. تم تسجيل توقيعك.">Thank you. Your signature has been recorded.</span>
            <t t-if="sign_request.state == 'signed'">
                <span class="es-i18n" data-en="All parties have signed: you will receive the signed document by email."
                      data-ar="وقّع جميع الأطراف: ستصلك الوثيقة الموقعة بالبريد.">All parties have signed: you will receive the signed document by email.</span>
            </t>
        </p>
        <p class="es-result-meta" t-if="item.signed_date">
            <span class="es-i18n" data-en="Signed on:" data-ar="تاريخ التوقيع:">Signed on:</span>
            <strong t-out="item.signed_date"/> UTC
        </p>
        <p t-if="sign_request.redirect_url">
            <a class="es-btn-outline" t-att-href="sign_request.redirect_url" rel="noopener noreferrer">
                <span class="es-i18n" data-en="Continue" data-ar="متابعة">Continue</span>
            </a>
        </p>
    </t>
</template>

<template id="sign_declined" name="Easy Sign - Signing Declined">
    <t t-call="easy_sign.result_layout">
        <t t-set="page_title" t-value="'Signing Declined - Easy Sign'"/>
        <t t-set="card_class" t-value="'es-result-declined'"/>
        <div class="es-result-icon">&#10005;</div>
        <button type="button" class="es-lang-btn">🌐 <span id="esLangLabel">عربي</span></button>
        <h2 class="es-result-title">
            <span class="es-i18n" data-en="Signing Declined" data-ar="تم رفض التوقيع">Signing Declined</span>
        </h2>
        <p class="es-result-message">
            <span class="es-i18n" data-en="You declined to sign this document. The requester has been notified."
                  data-ar="لقد رفضت التوقيع على الوثيقة. تم إشعار مقدم الطلب.">You declined to sign this document. The requester has been notified.</span>
        </p>
        <p class="es-result-meta" t-if="item.declined_reason">
            <span class="es-i18n" data-en="Reason:" data-ar="السبب:">Reason:</span>
            <em t-out="item.declined_reason"/>
        </p>
    </t>
</template>

<template id="sign_invalid" name="Easy Sign - Invalid Link">
    <t t-call="easy_sign.result_layout">
        <t t-set="page_title" t-value="'Easy Sign'"/>
        <t t-set="card_class" t-value="'es-result-invalid'"/>
        <div class="es-result-icon">&#9888;</div>
        <button type="button" class="es-lang-btn">🌐 <span id="esLangLabel">عربي</span></button>
        <h2 class="es-result-title" t-out="error_title or 'Invalid Link'"/>
        <p class="es-result-message" t-out="error_message or 'This signing link is invalid or has expired.'"/>
    </t>
</template>

<template id="verify_page" name="Easy Sign - Verify a Document">
    <t t-call="easy_sign.result_layout">
        <t t-set="page_title" t-value="'Verify a Signed Document - Easy Sign'"/>
        <t t-set="card_class" t-value="'es-result-verify'"/>
        <div class="es-result-icon">&#128269;</div>
        <button type="button" class="es-lang-btn">🌐 <span id="esLangLabel">عربي</span></button>
        <h2 class="es-result-title">
            <span class="es-i18n" data-en="Verify a Signed Document" data-ar="التحقق من وثيقة موقعة">Verify a Signed Document</span>
        </h2>
        <form method="post" action="/sign/verify" enctype="multipart/form-data" class="es-verify-form">
            <input type="hidden" name="csrf_token" t-att-value="csrf_token"/>
            <label class="es-info-label es-i18n" for="esVerifyCode" data-en="Verification code (printed at the bottom of each page)"
                   data-ar="رمز التحقق (مطبوع أسفل كل صفحة)">Verification code (printed at the bottom of each page)</label>
            <input id="esVerifyCode" type="text" name="code" maxlength="10" class="es-textarea" t-att-value="code or ''"/>
            <label class="es-info-label es-i18n" for="esVerifyFile" data-en="Signed PDF (optional, checks that the file was not altered)"
                   data-ar="الملف الموقع (اختياري، للتحقق من عدم تعديله)">Signed PDF (optional, checks that the file was not altered)</label>
            <input id="esVerifyFile" type="file" name="document" accept="application/pdf"/>
            <button type="submit" class="es-btn-sign"><span class="es-i18n" data-en="Verify" data-ar="تحقق">Verify</span></button>
        </form>
        <div t-if="error" class="es-msg es-msg-error"><span class="es-msg-icon">&#9888;</span><div t-out="error"/></div>
        <t t-if="submitted and not error">
            <div t-if="found and (file_matches or not file_checked) and chain_ok" class="es-msg es-msg-success">
                <span class="es-msg-icon">&#10004;</span>
                <div>
                    <strong t-if="file_matches">The file is authentic and has not been modified.</strong>
                    <strong t-else="">This verification code belongs to a completed signature.</strong>
                    <p>Completed on <t t-out="completed_date"/> UTC · <t t-out="signers_count"/> signer(s).</p>
                </div>
            </div>
            <div t-elif="found and file_checked and not file_matches" class="es-msg es-msg-error">
                <span class="es-msg-icon">&#9888;</span>
                <div><strong>The file does not match the signed document. It may have been modified.</strong></div>
            </div>
            <div t-elif="found and not chain_ok" class="es-msg es-msg-error">
                <span class="es-msg-icon">&#9888;</span>
                <div><strong>The audit trail of this document is not consistent.</strong></div>
            </div>
            <div t-else="" class="es-msg es-msg-error">
                <span class="es-msg-icon">&#9888;</span>
                <div><strong>No signed document matches this code or file.</strong></div>
            </div>
        </t>
    </t>
</template>

</odoo>
