<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Small forms opened from the editor (signer, role, document). -->
    <record id="view_sign_request_item_form" model="ir.ui.view">
        <field name="name">sign.request.item.form</field>
        <field name="model">sign.request.item</field>
        <field name="arch" type="xml">
            <form string="Signer">
                <group>
                    <field name="partner_id"/>
                    <field name="signer_name"/>
                    <field name="signer_email" required="1"/>
                    <field name="auth_method"/>
                    <field name="can_delegate"/>
                </group>
            </form>
        </field>
    </record>

    <record id="view_sign_role_form" model="ir.ui.view">
        <field name="name">sign.role.form</field>
        <field name="model">sign.role</field>
        <field name="arch" type="xml">
            <form string="Role">
                <group>
                    <field name="name"/>
                    <field name="default_partner_id"/>
                    <field name="auth_method"/>
                    <field name="can_delegate"/>
                    <field name="color" widget="color_picker"/>
                </group>
            </form>
        </field>
    </record>

    <record id="view_sign_document_form" model="ir.ui.view">
        <field name="name">sign.document.form</field>
        <field name="model">sign.document</field>
        <field name="arch" type="xml">
            <form string="Document">
                <group><field name="name"/></group>
            </form>
        </field>
    </record>
    <!-- Properties (gear in the editor). -->
    <record id="view_sign_request_properties_form" model="ir.ui.view">
        <field name="name">sign.request.properties.form</field>
        <field name="model">sign.request</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <form string="Properties">
                <group>
                    <group>
                        <field name="expiry_date"/>
                        <field name="reminder_days"/>
                        <field name="signing_order"/>
                        <field name="user_id"/>
                    </group>
                    <group>
                        <field name="cc_partner_ids" widget="many2many_tags"/>
                        <field name="redirect_url" widget="url"/>
                        <field name="subject" placeholder="Please sign: ..."/>
                        <field name="attachment_ids" widget="many2many_binary"/>
                    </group>
                </group>
                <field name="message" placeholder="Message for the signers"/>
            </form>
        </field>
    </record>

    <record id="view_sign_template_properties_form" model="ir.ui.view">
        <field name="name">sign.template.properties.form</field>
        <field name="model">sign.template</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <form string="Properties">
                <group>
                    <group>
                        <field name="model_id" options="{'no_create': True}"/>
                        <field name="validity_days"/>
                        <field name="reminder_days"/>
                        <field name="signing_order"/>
                    </group>
                    <group>
                        <field name="redirect_url" widget="url"/>
                        <field name="group_ids" widget="many2many_tags"/>
                        <field name="user_id"/>
                        <field name="default_subject"/>
                    </group>
                </group>
                <field name="default_message" placeholder="Default message for the signers"/>
            </form>
        </field>
    </record>
    <record id="view_sign_item_type_list" model="ir.ui.view">
        <field name="name">sign.item.type.list</field>
        <field name="model">sign.item.type</field>
        <field name="arch" type="xml">
            <list string="Signature Fields">
                <field name="sequence" widget="handle"/>
                <field name="name" string="Field Name"/>
                <field name="base_type"/>
                <field name="linked_model"/>
                <field name="linked_field_name"/>
                <field name="required" optional="hide"/>
                <field name="readonly" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_sign_item_type_search" model="ir.ui.view">
        <field name="name">sign.item.type.search</field>
        <field name="model">sign.item.type</field>
        <field name="arch" type="xml">
            <search string="Signature Fields">
                <field name="name" string="Field Name"/>
                <field name="base_type"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group name="group_by">
                    <filter name="group_type" string="Type" context="{'group_by': 'base_type'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_sign_item_type" model="ir.actions.act_window">
        <field name="name">Signature Fields</field>
        <field name="res_model">sign.item.type</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_sign_item_type_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a field type</p>
            <p>Field types make up the palette of the document editor.</p>
        </field>
    </record>
    <record id="view_sign_item_type_form" model="ir.ui.view">
        <field name="name">sign.item.type.form</field>
        <field name="model">sign.item.type</field>
        <field name="arch" type="xml">
            <form string="Field Type">
                <sheet>
                    <field name="active" invisible="1"/>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="base_type" widget="selection_badge" options="{'horizontal': true}"/>
                    <div class="oe_title mt-3">
                        <label for="name" string="Field Name"/>
                        <h1><field name="name" placeholder="e.g. Phone"/></h1>
                    </div>
                    <notebook>
                        <page string="Default values" name="defaults">
                            <group>
                                <group>
                                    <field name="placeholder" invisible="base_type not in ('text', 'textarea', 'date', 'selection')"/>
                                    <field name="tip"/>
                                    <field name="linked_model" invisible="not linked_field"/>
                                    <field name="linked_field" invisible="base_type not in ('text', 'textarea')"/>
                                    <field name="update_field" invisible="not linked_field or readonly"/>
                                </group>
                                <group>
                                    <field name="required" invisible="base_type == 'strike'"/>
                                    <field name="readonly" invisible="base_type not in ('text', 'textarea', 'date', 'selection')"/>
                                    <field name="alignment" invisible="base_type not in ('text', 'textarea', 'date', 'selection')"/>
                                    <field name="field_size" invisible="base_type not in ('text', 'textarea', 'date', 'selection')"/>
                                </group>
                            </group>
                        </page>
                        <page string="Editor" name="editor">
                            <group>
                                <group>
                                    <field name="icon"/>
                                </group>
                                <group>
                                    <field name="default_width"/>
                                    <field name="default_height"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>