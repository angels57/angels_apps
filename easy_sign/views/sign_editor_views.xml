<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Small forms opened from the editor (signer, role, document). -->
    <record id="view_sign_request_item_form" model="ir.ui.view">
        <field name="name">sign.request.item.form</field>
        <field name="model">sign.request.item</field>
        <field name="arch" type="xml">
            <form string="Signer">
                <group>
                    <field name="partner_id"/>
                    <field name="signer_name"/>
                    <field name="signer_email" required="1"/>
                    <field name="auth_method"/>
                    <field name="can_delegate"/>
                </group>
            </form>
        </field>
    </record>

    <record id="view_sign_role_form" model="ir.ui.view">
        <field name="name">sign.role.form</field>
        <field name="model">sign.role</field>
        <field name="arch" type="xml">
            <form string="Role">
                <group>
                    <field name="name"/>
                    <field name="default_partner_id"/>
                    <field name="auth_method"/>
                    <field name="can_delegate"/>
                    <field name="color" widget="color_picker"/>
                </group>
            </form>
        </field>
    </record>

    <record id="view_sign_document_form" model="ir.ui.view">
        <field name="name">sign.document.form</field>
        <field name="model">sign.document</field>
        <field name="arch" type="xml">
            <form string="Document">
                <group><field name="name"/></group>
            </form>
        </field>
    </record>
    <!-- Properties (gear in the editor). -->
    <record id="view_sign_request_properties_form" model="ir.ui.view">
        <field name="name">sign.request.properties.form</field>
        <field name="model">sign.request</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <form string="Properties">
                <group>
                    <group>
                        <field name="expiry_date"/>
                        <field name="reminder_days"/>
                        <field name="signing_order"/>
                        <field name="user_id"/>
                    </group>
                    <group>
                        <field name="cc_partner_ids" widget="many2many_tags"/>
                        <field name="redirect_url" widget="url"/>
                        <field name="subject" placeholder="Please sign: ..."/>
                        <field name="attachment_ids" widget="many2many_binary"/>
                    </group>
                </group>
                <field name="message" placeholder="Message for the signers"/>
            </form>
        </field>
    </record>

    <record id="view_sign_template_properties_form" model="ir.ui.view">
        <field name="name">sign.template.properties.form</field>
        <field name="model">sign.template</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <form string="Properties">
                <group>
                    <group>
                        <field name="model_id" options="{'no_create': True}"/>
                        <field name="validity_days"/>
                        <field name="reminder_days"/>
                        <field name="signing_order"/>
                    </group>
                    <group>
                        <field name="redirect_url" widget="url"/>
                        <field name="group_ids" widget="many2many_tags"/>
                        <field name="user_id"/>
                        <field name="default_subject"/>
                    </group>
                </group>
                <field name="default_message" placeholder="Default message for the signers"/>
            </form>
        </field>
    </record>
    <record id="view_sign_item_type_form" model="ir.ui.view">
        <field name="name">sign.item.type.form</field>
        <field name="model">sign.item.type</field>
        <field name="arch" type="xml">
            <form string="Field Type">
                <group>
                    <group>
                        <field name="name"/>
                        <field name="base_type"/>
                        <field name="linked_field" invisible="base_type not in ('text', 'textarea')"/>
                        <field name="icon"/>
                    </group>
                    <group>
                        <field name="default_width"/>
                        <field name="default_height"/>
                        <field name="required"/>
                        <field name="readonly" invisible="base_type not in ('text', 'textarea', 'date', 'selection')"/>
                        <field name="placeholder" invisible="base_type not in ('text', 'textarea', 'date', 'selection')"/>
                    </group>
                </group>
            </form>
        </field>
    </record>
</odoo>