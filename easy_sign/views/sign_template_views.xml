<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sign_template_list" model="ir.ui.view">
        <field name="name">sign.template.list</field>
        <field name="model">sign.template</field>
        <field name="arch" type="xml">
            <list js_class="easy_sign_list" string="Templates">
                <field name="name"/>
                <field name="model_id" optional="show"/>
                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}" optional="show"/>
                <field name="request_count" string="Used"/>
                <button name="action_create_request" type="object" string="Use" class="btn-link" icon="fa-paper-plane"/>
            </list>
        </field>
    </record>

    <record id="view_sign_template_form" model="ir.ui.view">
        <field name="name">sign.template.form</field>
        <field name="model">sign.template</field>
        <field name="arch" type="xml">
            <form string="Template">
                <header>
                    <button name="action_create_request" string="New Request" type="object" class="btn-primary"/>
                    <button name="action_edit_copy" string="Edit a Copy" type="object" invisible="not request_count"
                            groups="easy_sign.group_sign_manager"/>
                </header>
                <sheet>
                    <field name="active" invisible="1"/>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Employment Contract" readonly="request_count"/></h1>
                    </div>
                    <div class="alert alert-info" role="status" invisible="not request_count">
                        This template has been used: documents and fields are locked. Use "Edit a Copy" to change them.
                    </div>
                    <group>
                        <group>
                            <field name="role_ids" widget="many2many_tags" options="{'color_field': 'color', 'edit_tags': True}"/>
                            <field name="model_id" options="{'no_create': True}"/>
                            <field name="validity_days"/>
                            <field name="reminder_days"/>
                            <field name="signing_order"/>
                        </group>
                        <group>
                            <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                            <field name="redirect_url" widget="url"/>
                            <field name="group_ids" widget="many2many_tags"/>
                            <field name="user_id"/>
                            <field name="request_count" invisible="1"/>
                        </group>
                    </group>
                    <field name="document_ids" readonly="request_count" nolabel="1">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="file" widget="binary" filename="name" string="PDF"/>
                            <field name="name"/>
                            <field name="page_count" string="Pages"/>
                        </list>
                    </field>
                    <notebook>
                        <page string="Fields" name="fields">
                            <field name="item_count" widget="easy_sign_layout" nolabel="1"/>
                        </page>
                        <page string="Email" name="email">
                            <group><field name="default_subject"/></group>
                            <field name="default_message" placeholder="Default message for the signers"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sign_template_search" model="ir.ui.view">
        <field name="name">sign.template.search</field>
        <field name="model">sign.template</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="tag_ids"/>
                <filter string="Archived" name="filter_archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_sign_template" model="ir.actions.act_window">
        <field name="name">Templates</field>
        <field name="res_model">sign.template</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a reusable template</p>
            <p>Upload the PDF once, define the roles and place the fields.</p>
        </field>
    </record>

    <record id="view_sign_send_wizard_form" model="ir.ui.view">
        <field name="name">sign.send.wizard.form</field>
        <field name="model">sign.send.wizard</field>
        <field name="arch" type="xml">
            <form string="Request Signature">
                <field name="res_model" invisible="1"/>
                <field name="res_id" invisible="1"/>
                <field name="allowed_template_ids" invisible="1"/>
                <group>
                    <field name="template_id" options="{'no_create': True, 'no_open': True}"/>
                    <field name="file" filename="file_name" invisible="template_id" required="not template_id"/>
                    <field name="file_name" invisible="1"/>
                    <field name="expiry_date"/>
                </group>
                <field name="signer_ids" nolabel="1">
                    <list editable="bottom">
                        <field name="role_id" force_save="1" column_invisible="not parent.template_id"/>
                        <field name="partner_id" required="1"/>
                    </list>
                </field>
                <field name="message" placeholder="Message for the signers"/>
                <footer>
                    <button name="action_send" string="Send" type="object" class="btn-primary"/>
                    <button string="Discard" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
