<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sign_request_list" model="ir.ui.view">
        <field name="name">sign.request.list</field>
        <field name="model">sign.request</field>
        <field name="arch" type="xml">
            <list js_class="easy_sign_list" string="Signature Requests" decoration-muted="state in ('cancelled', 'expired')">
                <field name="name"/>
                <field name="document_name"/>
                <field name="user_id" optional="show"/>
                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}" optional="show"/>
                <field name="signed_count" string="Signed"/>
                <field name="signers_count" string="Signers"/>
                <field name="expiry_date" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'signed'" decoration-info="state == 'sent'"
                       decoration-warning="state == 'draft'" decoration-muted="state in ('cancelled', 'expired')"/>
            </list>
        </field>
    </record>

    <record id="view_sign_request_form" model="ir.ui.view">
        <field name="name">sign.request.form</field>
        <field name="model">sign.request</field>
        <field name="arch" type="xml">
            <form string="Signature Request" create="0">
                <header>
                    <button name="action_open_editor" string="Open Editor" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_send" string="Send" type="object" class="btn-primary"
                            invisible="state != 'sent' or not has_pending_signers"/>
                    <field name="has_pending_signers" invisible="1"/>
                    <button name="action_download_signed" string="Download Signed" type="object" class="btn-primary" invisible="state != 'signed'"/>
                    <button name="action_download_certificate" string="Certificate" type="object" invisible="state != 'signed' or not certificate_pdf"/>
                    <button name="action_cancel" string="Cancel Request" type="object" invisible="state not in ('draft', 'sent')"
                            confirm="Cancel this signature request? Pending signers will be notified."/>
                    <button name="action_reset_to_draft" string="Back to Draft" type="object" invisible="state not in ('cancelled', 'expired')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,sent,signed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="expiry_date" readonly="state != 'draft'"/>
                            <field name="reminder_days" readonly="state not in ('draft', 'sent')"/>
                            <field name="signing_order" readonly="state != 'draft'"/>
                            <field name="user_id" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="cc_partner_ids" widget="many2many_tags" readonly="state not in ('draft', 'sent')"/>
                            <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                            <field name="redirect_url" widget="url" readonly="state != 'draft'"/>
                            <field name="origin_ref" invisible="not origin_ref" readonly="1"/>
                            <field name="template_id" invisible="not template_id"/>
                            <field name="company_id" invisible="1"/>
                            <field name="certificate_pdf" invisible="1"/>
                        </group>
                    </group>
                    <field name="document_ids" readonly="1" nolabel="1">
                        <list>
                            <field name="file" widget="binary" filename="name" string="PDF"/>
                            <field name="name"/>
                            <field name="page_count" string="Pages"/>
                        </list>
                    </field>
                    <field name="request_item_ids" nolabel="1" readonly="state in ('signed', 'cancelled', 'expired')"
                           options="{'create': False, 'delete': False}">
                        <list editable="bottom">
                            <field name="sequence" column_invisible="1"/>
                            <field name="color" column_invisible="1"/>
                            <field name="partner_id" readonly="parent.state != 'draft' and not (can_delegate and state in ('waiting', 'sent', 'viewed'))"/>
                            <field name="signer_name" readonly="parent.state != 'draft' and not (can_delegate and state in ('waiting', 'sent', 'viewed'))"/>
                            <field name="signer_email" required="1" readonly="parent.state != 'draft' and not (can_delegate and state in ('waiting', 'sent', 'viewed'))"/>
                            <field name="role_id" optional="hide" readonly="parent.state != 'draft'"/>
                            <field name="auth_method" optional="show" readonly="parent.state != 'draft'"/>
                            <field name="can_delegate" optional="hide" readonly="parent.state != 'draft'"/>
                            <field name="state" widget="badge"
                                   decoration-success="state == 'signed'" decoration-info="state in ('sent', 'viewed')"
                                   decoration-danger="state == 'declined'" decoration-muted="state in ('cancelled', 'waiting')"/>
                            <field name="signed_date" optional="hide"/>
                            <field name="sign_url" widget="CopyClipboardChar" optional="show" invisible="state not in ('sent', 'viewed')"/>
                            <button name="action_resend" type="object" class="btn-link o_es_btn_send" title="Send again"
                                    invisible="state not in ('sent', 'viewed') or parent.state != 'sent'"/>
                        </list>
                    </field>
                    <notebook>
                        <page string="Audit" name="audit" invisible="state == 'draft'">
                            <group>
                                <field name="verification_code"/>
                                <field name="document_hash"/>
                                <field name="signed_document_hash" invisible="not signed_document_hash"/>
                                <field name="completed_date" invisible="not completed_date"/>
                            </group>
                            <field name="log_ids" readonly="1">
                                <list>
                                    <field name="date"/>
                                    <field name="action" widget="badge"/>
                                    <field name="signer_email"/>
                                    <field name="ip_address"/>
                                    <field name="user_agent" optional="hide"/>
                                    <field name="notes" optional="show"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_sign_request_search" model="ir.ui.view">
        <field name="name">sign.request.search</field>
        <field name="model">sign.request</field>
        <field name="arch" type="xml">
            <search string="Signature Requests">
                <field name="name"/>
                <field name="document_ids" string="Document"/>
                <field name="request_item_ids" string="Signer"/>
                <field name="tag_ids"/>
                <filter string="My Requests" name="filter_my" domain="[('user_id', '=', uid)]"/>
                <filter string="Waiting for Me" name="filter_to_sign"
                        domain="[('request_item_ids.partner_id.user_ids', 'in', [uid]), ('request_item_ids.state', 'in', ('sent', 'viewed'))]"/>
                <separator/>
                <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Pending" name="filter_sent" domain="[('state', '=', 'sent')]"/>
                <filter string="Signed" name="filter_signed" domain="[('state', '=', 'signed')]"/>
                <filter string="Cancelled / Expired" name="filter_closed" domain="[('state', 'in', ('cancelled', 'expired'))]"/>
                <separator/>
                <filter string="Archived" name="filter_archived" domain="[('active', '=', False)]"/>
                <group name="group_by">
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Requested By" name="group_user" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sign_request" model="ir.actions.act_window">
        <field name="name">Signature Requests</field>
        <field name="res_model">sign.request</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_sign_request_search"/>
        <field name="context">{'search_default_filter_my': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Send your first document for signature</p>
            <p>Add a PDF, the signers, place the fields and click Send.</p>
        </field>
    </record>

</odoo>
