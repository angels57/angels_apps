            <field name="name">Date</field><field name="sequence">12</field><field name="base_type">date</field>
            <field name="icon">date</field><field name="default_width">0.15</field>
        </record>
        <record id="item_type_strike" model="sign.item.type">
            <field name="name">Strikethrough</field><field name="sequence">13</field><field name="base_type">strike</field>
            <field name="icon">strike</field><field name="default_width">0.3</field><field name="default_height">0.015</field>
            <field name="required" eval="False"/>
        </record>
        <record id="item_type_stamp" model="sign.item.type">
            <field name="name">Stamp</field><field name="sequence">14</field><field name="base_type">stamp</field>
            <field name="icon">stamp</field><field name="default_width">0.15</field><field name="default_height">0.1</field>
        </record>
